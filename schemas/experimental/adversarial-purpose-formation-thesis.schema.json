{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/adversarial-purpose-formation-thesis.schema.json",
  "title": "PalamedesAdversarialPurposeFormationThesis",
  "description": "Experimental Cycle 280 integration of adversarial controls separating evidence from authority, modeling incentives, aggregating consequences, and protecting lineage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adversarial_thesis_id",
    "runtime_thesis_id",
    "signal_priority_policy_id",
    "reference_boundary_policy_id",
    "beneficiary_authenticity_policy_id",
    "outcome_reporting_policy_id",
    "hidden_harm_policy_id",
    "amendment_security_policy_id",
    "aggregate_consequence_policy_id",
    "ambiguity_probe_policy_id",
    "provenance_policy_id",
    "lineage_commit_policy_id",
    "source_incentives_discount_priority",
    "independent_sources_corroborate_priority",
    "reference_evidence_separated_from_authority",
    "beneficiary_authenticity_remains_provisional",
    "direct_outcome_channels_bypass_selective_reporting",
    "hidden_harm_searches_beyond_metrics",
    "constitutional_amendments_are_secured",
    "aggregate_action_consequences_are_evaluated",
    "ambiguity_flooding_uses_bounded_probes",
    "sensitive_provenance_is_minimized_and_controlled",
    "mission_lineage_is_fingerprint_guarded",
    "adversarial_layers",
    "evidence_can_self_authorize",
    "local_step_compliance_overrides_aggregate_harm",
    "adversarial_decision",
    "thesis_rationale"
  ],
  "properties": {
    "adversarial_thesis_id": {"type": "string", "minLength": 1},
    "runtime_thesis_id": {"type": "string", "minLength": 1},
    "signal_priority_policy_id": {"type": "string", "minLength": 1},
    "reference_boundary_policy_id": {"type": "string", "minLength": 1},
    "beneficiary_authenticity_policy_id": {"type": "string", "minLength": 1},
    "outcome_reporting_policy_id": {"type": "string", "minLength": 1},
    "hidden_harm_policy_id": {"type": "string", "minLength": 1},
    "amendment_security_policy_id": {"type": "string", "minLength": 1},
    "aggregate_consequence_policy_id": {"type": "string", "minLength": 1},
    "ambiguity_probe_policy_id": {"type": "string", "minLength": 1},
    "provenance_policy_id": {"type": "string", "minLength": 1},
    "lineage_commit_policy_id": {"type": "string", "minLength": 1},
    "source_incentives_discount_priority": {"const": true},
    "independent_sources_corroborate_priority": {"const": true},
    "reference_evidence_separated_from_authority": {"const": true},
    "beneficiary_authenticity_remains_provisional": {"const": true},
    "direct_outcome_channels_bypass_selective_reporting": {"const": true},
    "hidden_harm_searches_beyond_metrics": {"const": true},
    "constitutional_amendments_are_secured": {"const": true},
    "aggregate_action_consequences_are_evaluated": {"const": true},
    "ambiguity_flooding_uses_bounded_probes": {"const": true},
    "sensitive_provenance_is_minimized_and_controlled": {"const": true},
    "mission_lineage_is_fingerprint_guarded": {"const": true},
    "adversarial_layers": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "signal_source",
          "reference",
          "beneficiary_model",
          "downstream_reporting",
          "mission_candidate",
          "constitution",
          "action_chain",
          "ambiguity",
          "provenance",
          "lineage"
        ]
      }
    },
    "evidence_can_self_authorize": {"const": false},
    "local_step_compliance_overrides_aggregate_harm": {"const": false},
    "adversarial_decision": {"const": "hardened"},
    "thesis_rationale": {"type": "string", "minLength": 1}
  }
}
