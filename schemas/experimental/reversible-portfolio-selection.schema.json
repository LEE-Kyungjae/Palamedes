{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/reversible-portfolio-selection.schema.json",
  "title": "PalamedesReversiblePortfolioSelection",
  "description": "Experimental Cycle 139 selection preserving runner-ups and reversal triggers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selection_id",
    "portfolio_id",
    "primary_mission_id",
    "selected_scope",
    "selection_rationale",
    "review_window",
    "option_landscape_erased",
    "runner_up_missions",
    "reversal_triggers"
  ],
  "properties": {
    "selection_id": {"type": "string", "minLength": 1},
    "portfolio_id": {"type": "string", "minLength": 1},
    "primary_mission_id": {"type": "string", "minLength": 1},
    "selected_scope": {"type": "string", "minLength": 1},
    "selection_rationale": {"type": "string", "minLength": 1},
    "review_window": {"type": "string", "minLength": 1},
    "option_landscape_erased": {"const": false},
    "runner_up_missions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mission_id",
          "why_runner_up",
          "preserved_evidence_hash",
          "wake_trigger",
          "preservation_action"
        ],
        "properties": {
          "mission_id": {"type": "string", "minLength": 1},
          "why_runner_up": {"type": "string", "minLength": 1},
          "preserved_evidence_hash": {"type": "string", "minLength": 1},
          "wake_trigger": {"type": "string", "minLength": 1},
          "preservation_action": {"type": "string", "minLength": 1}
        }
      }
    },
    "reversal_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trigger_id",
          "signal",
          "threshold",
          "switch_to_mission_id",
          "reversal_action"
        ],
        "properties": {
          "trigger_id": {"type": "string", "minLength": 1},
          "signal": {"type": "string", "minLength": 1},
          "threshold": {"type": "string", "minLength": 1},
          "switch_to_mission_id": {"type": "string", "minLength": 1},
          "reversal_action": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
