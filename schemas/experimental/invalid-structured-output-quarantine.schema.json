{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/invalid-structured-output-quarantine.schema.json",
  "title": "PalamedesInvalidStructuredOutputQuarantine",
  "description": "Cycle 384 invalid model-output quarantine with bounded retry diagnostics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["quarantine_report_id", "quarantine_input", "quarantine_record", "report_fingerprint", "report_rationale"],
  "properties": {
    "quarantine_report_id": {"type": "string", "minLength": 1},
    "quarantine_input": {"type": "object"},
    "quarantine_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quarantine_record_version", "operation_id", "expected_schema_id", "provider_id", "model_id", "validation_errors", "retry_history", "maximum_attempts", "attempt_number", "retry_allowed", "quarantine_status", "canonical_state_fingerprint_before", "canonical_state_fingerprint_after", "invalid_output_promoted_to_canonical", "raw_output_embedded_in_canonical"],
      "properties": {
        "quarantine_record_version": {"const": "invalid-output-quarantine/1"},
        "operation_id": {"type": "string", "minLength": 1},
        "expected_schema_id": {"type": "string", "minLength": 1},
        "provider_id": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "validation_errors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "retry_history": {
          "type": "array", "minItems": 1, "maxItems": 10,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["attempt_number", "output_artifact_id", "output_fingerprint", "diagnostic_summary", "recorded_at"],
            "properties": {
              "attempt_number": {"type": "integer", "minimum": 1},
              "output_artifact_id": {"type": "string", "minLength": 1},
              "output_fingerprint": {"type": "string", "minLength": 1},
              "diagnostic_summary": {"type": "string", "minLength": 1},
              "recorded_at": {"type": "string", "minLength": 1}
            }
          }
        },
        "maximum_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "attempt_number": {"type": "integer", "minimum": 1, "maximum": 10},
        "retry_allowed": {"type": "boolean"},
        "quarantine_status": {"enum": ["retryable", "retry_exhausted"]},
        "canonical_state_fingerprint_before": {"type": "string", "minLength": 1},
        "canonical_state_fingerprint_after": {"type": "string", "minLength": 1},
        "invalid_output_promoted_to_canonical": {"const": false},
        "raw_output_embedded_in_canonical": {"const": false}
      }
    },
    "report_fingerprint": {"type": "string", "minLength": 1},
    "report_rationale": {"type": "string", "minLength": 1}
  }
}
