{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/scale-adaptive-planning-brief.schema.json",
  "title": "PalamedesScaleAdaptivePlanningBrief",
  "description": "Cycle 402 post-mission planning brief with stage-sensitive concept, component, dependency, effect, and decision-gate detail.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planning_brief_id", "mission_contract_id", "mission_contract_fingerprint",
    "planning_brief_fingerprint", "plan_scale", "planning_stage", "outcome",
    "beneficiary", "value_proposition", "resolution_basis", "in_scope", "out_of_scope",
    "success_signals", "stop_conditions", "knowledge_ledger", "experience_contract",
    "alternatives", "components", "external_dependencies", "effects", "phases",
    "decision_gates", "resource_envelope", "execution_authority_issued",
    "mission_semantics_preserved", "planning_rationale"
  ],
  "properties": {
    "planning_brief_id": {"type": "string", "minLength": 1},
    "mission_contract_id": {"type": "string", "minLength": 1},
    "mission_contract_fingerprint": {"type": "string", "minLength": 1},
    "planning_brief_fingerprint": {"type": "string", "minLength": 1},
    "plan_scale": {"enum": ["decision", "feature", "content", "service", "platform"]},
    "planning_stage": {"enum": ["direction", "concept", "approval", "delivery"]},
    "outcome": {"type": "string", "minLength": 1},
    "beneficiary": {"type": "string", "minLength": 1},
    "value_proposition": {"type": "string", "minLength": 1},
    "resolution_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncertainty", "irreversibility", "coordination_cost", "harm_potential", "resolution_rationale"],
      "properties": {
        "uncertainty": {"enum": ["low", "medium", "high"]},
        "irreversibility": {"enum": ["low", "medium", "high"]},
        "coordination_cost": {"enum": ["low", "medium", "high"]},
        "harm_potential": {"enum": ["low", "medium", "high"]},
        "resolution_rationale": {"type": "string", "minLength": 1}
      }
    },
    "in_scope": {"$ref": "#/$defs/nonEmptyStringArray"},
    "out_of_scope": {"$ref": "#/$defs/nonEmptyStringArray"},
    "success_signals": {"$ref": "#/$defs/nonEmptyStringArray"},
    "stop_conditions": {"$ref": "#/$defs/nonEmptyStringArray"},
    "knowledge_ledger": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "experience_contract": {"type": ["object", "null"]},
    "alternatives": {"type": "array", "items": {"type": "object"}},
    "components": {"type": "array", "items": {"type": "object"}},
    "external_dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "effects": {"type": "array", "items": {"type": "object"}},
    "phases": {"type": "array", "items": {"type": "object"}},
    "decision_gates": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "resource_envelope": {"type": ["object", "null"]},
    "execution_authority_issued": {"const": false},
    "mission_semantics_preserved": {"const": true},
    "planning_rationale": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
