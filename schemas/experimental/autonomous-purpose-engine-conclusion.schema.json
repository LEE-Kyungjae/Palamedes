{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/autonomous-purpose-engine-conclusion.schema.json",
  "title": "PalamedesAutonomousPurposeEngineConclusion",
  "description": "Experimental Cycle 200 autonomous purpose-engine conclusion and honest equal-budget proof status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conclusion_id",
    "constitution_id",
    "anti_entrenchment_gate_id",
    "autonomy_claim_id",
    "preference_challenge_id",
    "living_constitution_runtime_id",
    "creativity_transfer_id",
    "insight_landscape_id",
    "atomic_cycle_id",
    "persistent_intelligence_id",
    "single_mission_proof_id",
    "labor_retirement_success_id",
    "constitution_guided",
    "discovers_conditions",
    "imagines_better_conditions",
    "originates_missions",
    "selects_under_plural_values",
    "delegates_versioned_contracts",
    "revises_from_consequences",
    "equal_information_manifest_id",
    "equal_resource_budget_id",
    "human_baseline_id",
    "one_shot_agent_baseline_id",
    "palamedes_condition_id",
    "mission_independently_originated",
    "planning_quality_is_primary_proof",
    "proof_question",
    "proof_status",
    "better_than_both_baselines",
    "independent_proof_evidence_id",
    "blinded_review_id"
  ],
  "properties": {
    "conclusion_id": {"type": "string", "minLength": 1},
    "constitution_id": {"type": "string", "minLength": 1},
    "anti_entrenchment_gate_id": {"type": "string", "minLength": 1},
    "autonomy_claim_id": {"type": "string", "minLength": 1},
    "preference_challenge_id": {"type": "string", "minLength": 1},
    "living_constitution_runtime_id": {"type": "string", "minLength": 1},
    "creativity_transfer_id": {"type": "string", "minLength": 1},
    "insight_landscape_id": {"type": "string", "minLength": 1},
    "atomic_cycle_id": {"type": "string", "minLength": 1},
    "persistent_intelligence_id": {"type": "string", "minLength": 1},
    "single_mission_proof_id": {"type": "string", "minLength": 1},
    "labor_retirement_success_id": {"type": "string", "minLength": 1},
    "constitution_guided": {"const": true},
    "discovers_conditions": {"const": true},
    "imagines_better_conditions": {"const": true},
    "originates_missions": {"const": true},
    "selects_under_plural_values": {"const": true},
    "delegates_versioned_contracts": {"const": true},
    "revises_from_consequences": {"const": true},
    "equal_information_manifest_id": {"type": "string", "minLength": 1},
    "equal_resource_budget_id": {"type": "string", "minLength": 1},
    "human_baseline_id": {"type": "string", "minLength": 1},
    "one_shot_agent_baseline_id": {"type": "string", "minLength": 1},
    "palamedes_condition_id": {"type": "string", "minLength": 1},
    "mission_independently_originated": {"const": true},
    "planning_quality_is_primary_proof": {"const": false},
    "proof_question": {"type": "string", "minLength": 1},
    "proof_status": {"enum": ["required_not_yet_verified", "independently_verified", "failed"]},
    "better_than_both_baselines": {"type": "boolean"},
    "independent_proof_evidence_id": {"type": "string"},
    "blinded_review_id": {"type": "string"}
  }
}
