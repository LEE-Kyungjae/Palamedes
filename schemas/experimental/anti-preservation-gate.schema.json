{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/anti-preservation-gate.schema.json",
  "title": "PalamedesAntiPreservationGate",
  "description": "Experimental Cycle 160 adversarial persistence and replaceability gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate_id",
    "self_conflict_id",
    "temporal_lineage_id",
    "minimal_counterfactual_id",
    "verification_status_id",
    "anti_entrenchment_clause_id",
    "expansion_adversarial_hypothesis",
    "evidence_for_expansion",
    "evidence_against_expansion",
    "decision_rationale",
    "self_conflict_reviewed",
    "expansion_tested_adversarially",
    "simpler_replacement_tested",
    "retirement_executable",
    "simpler_system_adequate",
    "continued_existence_is_default",
    "decision"
  ],
  "properties": {
    "gate_id": {"type": "string", "minLength": 1},
    "self_conflict_id": {"type": "string", "minLength": 1},
    "temporal_lineage_id": {"type": "string", "minLength": 1},
    "minimal_counterfactual_id": {"type": "string", "minLength": 1},
    "verification_status_id": {"type": "string", "minLength": 1},
    "anti_entrenchment_clause_id": {"type": "string", "minLength": 1},
    "expansion_adversarial_hypothesis": {"type": "string", "minLength": 1},
    "evidence_for_expansion": {"type": "string", "minLength": 1},
    "evidence_against_expansion": {"type": "string", "minLength": 1},
    "decision_rationale": {"type": "string", "minLength": 1},
    "self_conflict_reviewed": {"const": true},
    "expansion_tested_adversarially": {"const": true},
    "simpler_replacement_tested": {"const": true},
    "retirement_executable": {"const": true},
    "simpler_system_adequate": {"type": "boolean"},
    "continued_existence_is_default": {"const": false},
    "decision": {"enum": ["continue_current", "replace_with_simpler", "retire"]}
  }
}
