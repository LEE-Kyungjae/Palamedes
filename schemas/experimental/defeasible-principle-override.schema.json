{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/defeasible-principle-override.schema.json",
  "title": "PalamedesDefeasiblePrincipleOverride",
  "description": "Experimental Cycle 214 contract for evidenced, predicted, bounded principle overrides.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "override_id",
    "principle_id",
    "mission_id",
    "requested_by",
    "default_principle_action",
    "proposed_exception",
    "override_reason",
    "preferred_mission_is_sufficient_reason",
    "evidence_ids",
    "affected_beneficiaries",
    "predicted_consequence_with_override",
    "predicted_consequence_without_override",
    "prediction_window",
    "falsification_signal",
    "decision",
    "approved_scope",
    "override_is_permanent",
    "expiry_at",
    "review_owner"
  ],
  "properties": {
    "override_id": {"type": "string", "minLength": 1},
    "principle_id": {"type": "string", "minLength": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "requested_by": {"type": "string", "minLength": 1},
    "default_principle_action": {"type": "string", "minLength": 1},
    "proposed_exception": {"type": "string", "minLength": 1},
    "override_reason": {"type": "string", "minLength": 1},
    "preferred_mission_is_sufficient_reason": {"const": false},
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "affected_beneficiaries": {"type": "string", "minLength": 1},
    "predicted_consequence_with_override": {"type": "string", "minLength": 1},
    "predicted_consequence_without_override": {"type": "string", "minLength": 1},
    "prediction_window": {"type": "string", "minLength": 1},
    "falsification_signal": {"type": "string", "minLength": 1},
    "decision": {"enum": ["approve_bounded", "reject", "defer"]},
    "approved_scope": {"type": "string"},
    "override_is_permanent": {"type": "boolean"},
    "expiry_at": {"type": "string", "minLength": 1},
    "review_owner": {"type": "string", "minLength": 1}
  }
}
