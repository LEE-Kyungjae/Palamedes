{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/observation-coverage-map.schema.json",
  "title": "PalamedesObservationCoverageMap",
  "description": "Experimental Cycle 205 coverage map for systematically unobserved beneficiaries and consequences.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "coverage_map_id",
    "observation_system_id",
    "review_period",
    "data_source_ids",
    "silence_counts_as_coverage",
    "coverage_entries",
    "missing_report_trigger",
    "coverage_summary"
  ],
  "properties": {
    "coverage_map_id": {"type": "string", "minLength": 1},
    "observation_system_id": {"type": "string", "minLength": 1},
    "review_period": {"type": "string", "minLength": 1},
    "data_source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "silence_counts_as_coverage": {"const": false},
    "coverage_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "beneficiary_group",
          "consequence_type",
          "coverage_status",
          "source_ids",
          "visibility_reason",
          "collection_incentive",
          "mitigation"
        ],
        "properties": {
          "beneficiary_group": {"type": "string", "minLength": 1},
          "consequence_type": {"type": "string", "minLength": 1},
          "coverage_status": {"enum": ["observed", "partial", "unobserved"]},
          "source_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "visibility_reason": {"type": "string", "minLength": 1},
          "collection_incentive": {"type": "string", "minLength": 1},
          "mitigation": {"type": "string", "minLength": 1}
        }
      }
    },
    "missing_report_trigger": {"type": "string", "minLength": 1},
    "coverage_summary": {"type": "string", "minLength": 1}
  }
}
