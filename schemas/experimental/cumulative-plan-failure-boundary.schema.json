{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/cumulative-plan-failure-boundary.schema.json",
  "title": "PalamedesCumulativePlanFailureBoundary",
  "description": "Experimental Cycle 178 cumulative boundary between replanning and mission feasibility challenge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "mission_contract_id",
    "mission_contract_version",
    "feasibility_assumption_id",
    "feasibility_assumption",
    "single_failure_disconfirms_mission",
    "pre_registered_failure_threshold",
    "minimum_distinct_strategy_families",
    "plan_attempts",
    "decision",
    "decision_rationale"
  ],
  "properties": {
    "review_id": {"type": "string", "minLength": 1},
    "mission_contract_id": {"type": "string", "minLength": 1},
    "mission_contract_version": {"type": "string", "minLength": 1},
    "feasibility_assumption_id": {"type": "string", "minLength": 1},
    "feasibility_assumption": {"type": "string", "minLength": 1},
    "single_failure_disconfirms_mission": {"const": false},
    "pre_registered_failure_threshold": {"type": "integer", "minimum": 2},
    "minimum_distinct_strategy_families": {"type": "integer", "minimum": 2},
    "plan_attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_id",
          "strategy_family",
          "failure_observation",
          "failure_evidence_id",
          "feasibility_assumption_id",
          "execution_adequate",
          "assumption_implicated"
        ],
        "properties": {
          "attempt_id": {"type": "string", "minLength": 1},
          "strategy_family": {"type": "string", "minLength": 1},
          "failure_observation": {"type": "string", "minLength": 1},
          "failure_evidence_id": {"type": "string", "minLength": 1},
          "feasibility_assumption_id": {"type": "string", "minLength": 1},
          "execution_adequate": {"type": "boolean"},
          "assumption_implicated": {"type": "boolean"}
        }
      }
    },
    "decision": {"enum": ["replan", "challenge_mission_feasibility"]},
    "decision_rationale": {"type": "string", "minLength": 1}
  }
}
