{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/four-mode-mission-selection.schema.json",
  "title": "PalamedesFourModeMissionSelection",
  "description": "Experimental Cycle 317 commitment, exploration, probe, or defer from frozen candidates and critiques.",
  "type": "object",
  "additionalProperties": false,
  "required": ["selection_record_id", "proposal_batch_id", "mission_tournament_id", "constitution_state_id", "selection_authority_id", "candidate_evidence", "decision", "decision_details", "candidates_mutated_during_selection", "critiques_treated_as_authority", "selection_rationale"],
  "properties": {
    "selection_record_id": {"type": "string", "minLength": 1},
    "proposal_batch_id": {"type": "string", "minLength": 1},
    "mission_tournament_id": {"type": "string", "minLength": 1},
    "constitution_state_id": {"type": "string", "minLength": 1},
    "selection_authority_id": {"type": "string", "minLength": 1},
    "candidate_evidence": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["mission_candidate_id", "candidate_fingerprint", "forecast_fingerprint", "critique_record_ids", "frozen"],
        "properties": {
          "mission_candidate_id": {"type": "string", "minLength": 1},
          "candidate_fingerprint": {"type": "string", "minLength": 1},
          "forecast_fingerprint": {"type": "string", "minLength": 1},
          "critique_record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "frozen": {"const": true}
        }
      }
    },
    "decision": {"enum": ["commit", "bounded_exploration", "discriminating_probe", "defer"]},
    "decision_details": {
      "type": "object",
      "required": ["selected_mission_candidate_ids"],
      "properties": {
        "selected_mission_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "commitment_scope": {"type": "string", "minLength": 1},
        "commitment_review_trigger": {"type": "string", "minLength": 1},
        "exploration_budget": {"type": "string", "minLength": 1},
        "expires_at": {"type": "string", "minLength": 1},
        "stop_condition": {"type": "string", "minLength": 1},
        "learning_objective": {"type": "string", "minLength": 1},
        "probe_id": {"type": "string", "minLength": 1},
        "ambiguity_id": {"type": "string", "minLength": 1},
        "probe_budget": {"type": "string", "minLength": 1},
        "maximum_harm": {"type": "string", "minLength": 1},
        "missing_condition": {"type": "string", "minLength": 1},
        "wake_trigger": {"type": "string", "minLength": 1},
        "review_at": {"type": "string", "minLength": 1}
      }
    },
    "candidates_mutated_during_selection": {"const": false},
    "critiques_treated_as_authority": {"const": false},
    "selection_rationale": {"type": "string", "minLength": 1}
  }
}
