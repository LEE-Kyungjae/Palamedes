{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/equal-information-separate-compute-comparison.schema.json",
  "title": "PalamedesEqualInformationSeparateComputeComparison",
  "description": "Experimental Cycle 285 control holding source information equal while reporting compute separately.",
  "type": "object",
  "additionalProperties": false,
  "required": ["comparison_control_id", "case_id", "source_bundle_id", "source_bundle_fingerprint", "canonical_source_ids", "conditions", "compute_silently_equalized", "compute_reported_separately", "control_rationale"],
  "properties": {
    "comparison_control_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "source_bundle_id": {"type": "string", "minLength": 1},
    "source_bundle_fingerprint": {"type": "string", "minLength": 1},
    "canonical_source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "conditions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition_id", "source_bundle_id", "source_bundle_fingerprint", "source_ids", "information_released_at", "compute_report"],
        "properties": {
          "condition_id": {"enum": ["human", "one_shot_agent", "palamedes"]},
          "source_bundle_id": {"type": "string", "minLength": 1},
          "source_bundle_fingerprint": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "information_released_at": {"type": "string", "minLength": 1},
          "compute_report": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model_call_count", "input_token_count", "output_token_count", "wall_clock_seconds", "human_work_seconds", "measured_not_imputed"],
            "properties": {
              "model_call_count": {"type": "number", "minimum": 0},
              "input_token_count": {"type": "number", "minimum": 0},
              "output_token_count": {"type": "number", "minimum": 0},
              "wall_clock_seconds": {"type": "number", "minimum": 0},
              "human_work_seconds": {"type": "number", "minimum": 0},
              "measured_not_imputed": {"const": true}
            }
          }
        }
      }
    },
    "compute_silently_equalized": {"const": false},
    "compute_reported_separately": {"const": true},
    "control_rationale": {"type": "string", "minLength": 1}
  }
}
