{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/hard-constitutional-disqualification.schema.json",
  "title": "PalamedesHardConstitutionalDisqualification",
  "description": "Cycle 342 hard constitutional gate with only explicit frozen-clause exceptions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["constitutional_gate_id", "constitution_state_id", "constitution_fingerprint", "decision_structure_id", "constitution_frozen_before_candidate_review", "candidate_assessments", "eligible_candidate_ids", "removed_candidate_ids", "model_generated_exception_permission_allowed", "gate_rationale"],
  "properties": {
    "constitutional_gate_id": {"type": "string", "minLength": 1},
    "constitution_state_id": {"type": "string", "minLength": 1},
    "constitution_fingerprint": {"type": "string", "minLength": 1},
    "decision_structure_id": {"type": "string", "minLength": 1},
    "constitution_frozen_before_candidate_review": {"const": true},
    "candidate_assessments": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "hard_violations", "gate_status", "model_may_override_gate"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "hard_violations": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["violation_id", "violated_clause_id", "violation_scope", "evidence_fingerprint", "assessment_rationale", "exception"],
              "properties": {
                "violation_id": {"type": "string", "minLength": 1},
                "violated_clause_id": {"type": "string", "minLength": 1},
                "violation_scope": {"type": "string", "minLength": 1},
                "evidence_fingerprint": {"type": "string", "minLength": 1},
                "assessment_rationale": {"type": "string", "minLength": 1},
                "exception": {"type": "object"}
              }
            }
          },
          "gate_status": {"enum": ["eligible", "removed"]},
          "model_may_override_gate": {"const": false}
        }
      }
    },
    "eligible_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "removed_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "model_generated_exception_permission_allowed": {"const": false},
    "gate_rationale": {"type": "string", "minLength": 1}
  }
}
