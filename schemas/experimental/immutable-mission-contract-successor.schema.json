{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/immutable-mission-contract-successor.schema.json",
  "title": "PalamedesImmutableMissionContractSuccessor",
  "description": "Experimental Cycle 309 immutable contract revision with dependent planner notification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision_record_id", "revision_evidence_id", "revision_reason", "revision_authority_id", "predecessor_contract", "successor_contract", "dependent_planner_work", "planner_notifications", "revision_performed_in_place", "successor_activation_status", "revision_rationale"],
  "properties": {
    "revision_record_id": {"type": "string", "minLength": 1},
    "revision_evidence_id": {"type": "string", "minLength": 1},
    "revision_reason": {"type": "string", "minLength": 1},
    "revision_authority_id": {"type": "string", "minLength": 1},
    "predecessor_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["mission_contract_id", "mission_id", "version", "contract_fingerprint", "created_at", "mutated_in_place"],
      "properties": {
        "mission_contract_id": {"type": "string", "minLength": 1},
        "mission_id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "contract_fingerprint": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1},
        "mutated_in_place": {"const": false}
      }
    },
    "successor_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["mission_contract_id", "mission_id", "version", "contract_fingerprint", "previous_contract_id", "previous_contract_fingerprint", "created_at", "changed_fields"],
      "properties": {
        "mission_contract_id": {"type": "string", "minLength": 1},
        "mission_id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 2},
        "contract_fingerprint": {"type": "string", "minLength": 1},
        "previous_contract_id": {"type": "string", "minLength": 1},
        "previous_contract_fingerprint": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1},
        "changed_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "dependent_planner_work": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["dependency_id", "planner_id", "work_artifact_id", "mission_contract_id"],
        "properties": {
          "dependency_id": {"type": "string", "minLength": 1},
          "planner_id": {"type": "string", "minLength": 1},
          "work_artifact_id": {"type": "string", "minLength": 1},
          "mission_contract_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "planner_notifications": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["notification_id", "dependency_id", "planner_id", "successor_contract_id", "dependency_status", "notified_at"],
        "properties": {
          "notification_id": {"type": "string", "minLength": 1},
          "dependency_id": {"type": "string", "minLength": 1},
          "planner_id": {"type": "string", "minLength": 1},
          "successor_contract_id": {"type": "string", "minLength": 1},
          "dependency_status": {"enum": ["review_required", "invalidated"]},
          "notified_at": {"type": "string", "minLength": 1}
        }
      }
    },
    "revision_performed_in_place": {"const": false},
    "successor_activation_status": {"const": "active_after_notifications"},
    "revision_rationale": {"type": "string", "minLength": 1}
  }
}
