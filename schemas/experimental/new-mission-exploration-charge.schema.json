{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/new-mission-exploration-charge.schema.json",
  "title": "PalamedesNewMissionExplorationCharge",
  "description": "Experimental Cycle 185 finite exploration and displacement charge for a new mission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "admission_id",
    "portfolio_id",
    "new_mission_id",
    "exploration_budget_id",
    "total_exploration_capacity",
    "currently_committed_capacity",
    "requested_capacity",
    "displaced_option_id",
    "displaced_capacity_released",
    "displacement_consequence",
    "displaced_option_lineage_preserved",
    "displaced_option_wake_trigger",
    "attention_cost",
    "new_mission_is_free",
    "decision",
    "admission_rationale"
  ],
  "properties": {
    "admission_id": {"type": "string", "minLength": 1},
    "portfolio_id": {"type": "string", "minLength": 1},
    "new_mission_id": {"type": "string", "minLength": 1},
    "exploration_budget_id": {"type": "string", "minLength": 1},
    "total_exploration_capacity": {"type": "number", "minimum": 0},
    "currently_committed_capacity": {"type": "number", "minimum": 0},
    "requested_capacity": {"type": "number", "exclusiveMinimum": 0},
    "displaced_option_id": {"type": "string", "minLength": 1},
    "displaced_capacity_released": {"type": "number", "minimum": 0},
    "displacement_consequence": {"type": "string", "minLength": 1},
    "displaced_option_lineage_preserved": {"const": true},
    "displaced_option_wake_trigger": {"type": "string", "minLength": 1},
    "attention_cost": {"type": "number", "exclusiveMinimum": 0},
    "new_mission_is_free": {"const": false},
    "decision": {"enum": ["admit", "reject"]},
    "admission_rationale": {"type": "string", "minLength": 1}
  }
}
