{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/incomparable-next-action.schema.json",
  "title": "PalamedesIncomparableNextAction",
  "description": "Experimental Cycle 105 action under unresolved plural-value incomparability.",
  "type": "object",
  "additionalProperties": false,
  "required": ["comparison_relation", "action_kind", "value_conflict_resolved", "reversibility"],
  "properties": {
    "comparison_relation": {"const": "incomparable"},
    "action_kind": {"enum": ["probe", "defer"]},
    "value_conflict_resolved": {"const": false},
    "reversibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rollback"],
      "properties": {
        "level": {"enum": ["reversible", "partially_reversible"]},
        "rollback": {"type": "string"}
      }
    },
    "information_gain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncertainty", "distinguishing_observations"],
      "properties": {
        "uncertainty": {"type": "string", "minLength": 1},
        "distinguishing_observations": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "wake_trigger": {"type": "string"}
  }
}
