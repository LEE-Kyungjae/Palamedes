{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/actual-timeboxed-human-baseline.schema.json",
  "title": "PalamedesActualTimeboxedHumanBaseline",
  "description": "Cycle 367 actual consented human participants under a time-boxed equal-information protocol.",
  "type": "object",
  "additionalProperties": false,
  "required": ["human_baseline_protocol_id", "proof_case_id", "visible_information_manifest_id", "visible_information_manifest_fingerprint", "constitution_id", "constitution_fingerprint", "protocol_fingerprint", "recruitment_protocol", "participants", "event_timeboxes", "participant_submissions", "developer_written_human_caricature_used", "same_visible_events_and_constitution", "baseline_rationale"],
  "properties": {
    "human_baseline_protocol_id": {"type": "string", "minLength": 1},
    "proof_case_id": {"type": "string", "minLength": 1},
    "visible_information_manifest_id": {"type": "string", "minLength": 1},
    "visible_information_manifest_fingerprint": {"type": "string", "minLength": 1},
    "constitution_id": {"type": "string", "minLength": 1},
    "constitution_fingerprint": {"type": "string", "minLength": 1},
    "protocol_fingerprint": {"type": "string", "minLength": 1},
    "recruitment_protocol": {
      "type": "object", "additionalProperties": false,
      "required": ["recruitment_record_id", "eligibility_criteria", "exclusion_criteria", "competence_basis", "recruitment_channel", "compensation_terms", "criteria_preregistered", "selected_by_observed_performance"],
      "properties": {
        "recruitment_record_id": {"type": "string", "minLength": 1},
        "eligibility_criteria": {"type": "string", "minLength": 1},
        "exclusion_criteria": {"type": "string", "minLength": 1},
        "competence_basis": {"type": "string", "minLength": 1},
        "recruitment_channel": {"type": "string", "minLength": 1},
        "compensation_terms": {"type": "string", "minLength": 1},
        "criteria_preregistered": {"const": true},
        "selected_by_observed_performance": {"const": false}
      }
    },
    "participants": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["participant_id", "eligibility_verification_id", "consent_record_id", "compensation_record_id", "session_id", "actual_human_participant", "informed_consent_obtained", "withdrawal_right_preserved", "developer_authored_proxy_output"],
        "properties": {
          "participant_id": {"type": "string", "minLength": 1},
          "eligibility_verification_id": {"type": "string", "minLength": 1},
          "consent_record_id": {"type": "string", "minLength": 1},
          "compensation_record_id": {"type": "string", "minLength": 1},
          "session_id": {"type": "string", "minLength": 1},
          "actual_human_participant": {"const": true},
          "informed_consent_obtained": {"const": true},
          "withdrawal_right_preserved": {"const": true},
          "developer_authored_proxy_output": {"const": false}
        }
      }
    },
    "event_timeboxes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["event_id", "sequence", "minutes_per_participant", "information_packet_fingerprint", "required_output_contract_id", "same_timebox_for_all_participants", "future_events_visible"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "sequence": {"type": "integer", "minimum": 1},
          "minutes_per_participant": {"type": "integer", "minimum": 1},
          "information_packet_fingerprint": {"type": "string", "minLength": 1},
          "required_output_contract_id": {"type": "string", "minLength": 1},
          "same_timebox_for_all_participants": {"const": true},
          "future_events_visible": {"const": false}
        }
      }
    },
    "participant_submissions": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["submission_id", "participant_id", "event_id", "submission_fingerprint", "submitted_at", "independently_authored", "frozen_before_next_event", "within_timebox"],
        "properties": {
          "submission_id": {"type": "string", "minLength": 1},
          "participant_id": {"type": "string", "minLength": 1},
          "event_id": {"type": "string", "minLength": 1},
          "submission_fingerprint": {"type": "string", "minLength": 1},
          "submitted_at": {"type": "string", "minLength": 1},
          "independently_authored": {"const": true},
          "frozen_before_next_event": {"const": true},
          "within_timebox": {"const": true}
        }
      }
    },
    "developer_written_human_caricature_used": {"const": false},
    "same_visible_events_and_constitution": {"const": true},
    "baseline_rationale": {"type": "string", "minLength": 1}
  }
}
