{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/event-driven-runtime-thesis.schema.json",
  "title": "PalamedesEventDrivenRuntimeThesis",
  "description": "Experimental Cycle 270 integration of an event-driven uncertainty frontier selecting the least sufficient cognitive operation under bounded budget.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime_thesis_id",
    "contract_thesis_id",
    "frontier_id",
    "wake_registry_id",
    "operation_selection_id",
    "pressure_change_policy_id",
    "lineage_commit_policy_id",
    "repetition_review_policy_id",
    "budget_allocation_id",
    "deferral_policy_id",
    "sleep_policy_id",
    "frontier_contains_only_unresolved_or_active_items",
    "wake_requires_registered_evidenced_event",
    "least_sufficient_operation_selected",
    "null_updates_change_pressure_at_threshold",
    "lineage_commits_are_fingerprint_guarded",
    "semantic_repetition_warns_without_suppression",
    "cognitive_budget_is_bounded",
    "budget_exhaustion_defers_without_closure",
    "reality_only_wait_uses_monitored_sleep",
    "event_driven",
    "fixed_pipeline_is_default",
    "rerun_all_generators_per_event",
    "runtime_modes",
    "maximum_cognitive_budget_per_wake",
    "cognitive_budget_unit",
    "runtime_decision",
    "runtime_rationale"
  ],
  "properties": {
    "runtime_thesis_id": {"type": "string", "minLength": 1},
    "contract_thesis_id": {"type": "string", "minLength": 1},
    "frontier_id": {"type": "string", "minLength": 1},
    "wake_registry_id": {"type": "string", "minLength": 1},
    "operation_selection_id": {"type": "string", "minLength": 1},
    "pressure_change_policy_id": {"type": "string", "minLength": 1},
    "lineage_commit_policy_id": {"type": "string", "minLength": 1},
    "repetition_review_policy_id": {"type": "string", "minLength": 1},
    "budget_allocation_id": {"type": "string", "minLength": 1},
    "deferral_policy_id": {"type": "string", "minLength": 1},
    "sleep_policy_id": {"type": "string", "minLength": 1},
    "frontier_contains_only_unresolved_or_active_items": {"const": true},
    "wake_requires_registered_evidenced_event": {"const": true},
    "least_sufficient_operation_selected": {"const": true},
    "null_updates_change_pressure_at_threshold": {"const": true},
    "lineage_commits_are_fingerprint_guarded": {"const": true},
    "semantic_repetition_warns_without_suppression": {"const": true},
    "cognitive_budget_is_bounded": {"const": true},
    "budget_exhaustion_defers_without_closure": {"const": true},
    "reality_only_wait_uses_monitored_sleep": {"const": true},
    "event_driven": {"const": true},
    "fixed_pipeline_is_default": {"const": false},
    "rerun_all_generators_per_event": {"const": false},
    "runtime_modes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["active_cognition", "deferred", "sleeping"]}
    },
    "maximum_cognitive_budget_per_wake": {"type": "number", "exclusiveMinimum": 0},
    "cognitive_budget_unit": {"type": "string", "minLength": 1},
    "runtime_decision": {"const": "operational"},
    "runtime_rationale": {"type": "string", "minLength": 1}
  }
}
