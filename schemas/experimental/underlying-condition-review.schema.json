{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/underlying-condition-review.schema.json",
  "title": "PalamedesUnderlyingConditionReview",
  "description": "Experimental Cycle 167 retirement of goals whose underlying beneficiary condition has disappeared.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "mission_id",
    "underlying_condition_id",
    "original_condition",
    "current_condition_observation",
    "condition_evidence_id",
    "condition_status",
    "mission_was_successful",
    "goal_preservation_is_default",
    "decision",
    "decision_rationale",
    "delegations_revoked",
    "resources_stopped",
    "downstream_notified",
    "lineage_preserved",
    "reopen_trigger"
  ],
  "properties": {
    "review_id": {"type": "string", "minLength": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "underlying_condition_id": {"type": "string", "minLength": 1},
    "original_condition": {"type": "string", "minLength": 1},
    "current_condition_observation": {"type": "string", "minLength": 1},
    "condition_evidence_id": {"type": "string", "minLength": 1},
    "condition_status": {"enum": ["persists", "changed", "resolved", "disappeared"]},
    "mission_was_successful": {"type": "boolean"},
    "goal_preservation_is_default": {"const": false},
    "decision": {"enum": ["continue", "revise", "retire"]},
    "decision_rationale": {"type": "string", "minLength": 1},
    "delegations_revoked": {"type": "boolean"},
    "resources_stopped": {"type": "boolean"},
    "downstream_notified": {"type": "boolean"},
    "lineage_preserved": {"type": "boolean"},
    "reopen_trigger": {"type": "string", "minLength": 1}
  }
}
