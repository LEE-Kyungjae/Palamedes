{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/request-need-hypotheses.schema.json",
  "title": "PalamedesRequestNeedHypotheses",
  "description": "Experimental Cycle 111 contract separating a stated request from desired lived-condition change.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "stated_request",
    "proposed_solution",
    "desired_condition",
    "requested_solution_status",
    "status_rationale",
    "source_ids",
    "request_is_need",
    "need_hypotheses"
  ],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "stated_request": {"type": "string", "minLength": 1},
    "proposed_solution": {"type": "string", "minLength": 1},
    "desired_condition": {"type": "string", "minLength": 1},
    "requested_solution_status": {"enum": ["plausible", "uncertain", "contradicted"]},
    "status_rationale": {"type": "string", "minLength": 1},
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "request_is_need": {"const": false},
    "need_hypotheses": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis_id", "condition_change", "distinguishing_observation"],
        "properties": {
          "hypothesis_id": {"type": "string", "minLength": 1},
          "condition_change": {"type": "string", "minLength": 1},
          "distinguishing_observation": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
