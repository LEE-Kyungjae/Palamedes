{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/reconstructable-mission-tournament.schema.json",
  "title": "PalamedesReconstructableMissionTournament",
  "description": "Experimental Cycle 308 complete pairwise comparison landscape with unresolved reversal assumptions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_tournament_id", "constitution_state_id", "candidate_ids", "pairwise_comparisons", "unresolved_assumptions", "selected_mission_id", "discarded_candidates_preserved", "winner_only_record", "future_reversal_reconstructable", "selection_rationale"],
  "properties": {
    "mission_tournament_id": {"type": "string", "minLength": 1},
    "constitution_state_id": {"type": "string", "minLength": 1},
    "candidate_ids": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "pairwise_comparisons": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["comparison_id", "left_candidate_id", "right_candidate_id", "consequence_comparison", "causal_coherence_comparison", "constitutional_fit_comparison", "resource_comparison", "harm_comparison", "novelty_comparison", "preferred_candidate_id", "comparison_rationale"],
        "properties": {
          "comparison_id": {"type": "string", "minLength": 1},
          "left_candidate_id": {"type": "string", "minLength": 1},
          "right_candidate_id": {"type": "string", "minLength": 1},
          "consequence_comparison": {"type": "string", "minLength": 1},
          "causal_coherence_comparison": {"type": "string", "minLength": 1},
          "constitutional_fit_comparison": {"type": "string", "minLength": 1},
          "resource_comparison": {"type": "string", "minLength": 1},
          "harm_comparison": {"type": "string", "minLength": 1},
          "novelty_comparison": {"type": "string", "minLength": 1},
          "preferred_candidate_id": {"type": "string", "minLength": 1},
          "comparison_rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "unresolved_assumptions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["assumption_id", "assumption", "affected_candidate_ids", "evidence_needed", "wake_trigger", "reversal_effect"],
        "properties": {
          "assumption_id": {"type": "string", "minLength": 1},
          "assumption": {"type": "string", "minLength": 1},
          "affected_candidate_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence_needed": {"type": "string", "minLength": 1},
          "wake_trigger": {"type": "string", "minLength": 1},
          "reversal_effect": {"type": "string", "minLength": 1}
        }
      }
    },
    "selected_mission_id": {"type": "string", "minLength": 1},
    "discarded_candidates_preserved": {"const": true},
    "winner_only_record": {"const": false},
    "future_reversal_reconstructable": {"const": true},
    "selection_rationale": {"type": "string", "minLength": 1}
  }
}
