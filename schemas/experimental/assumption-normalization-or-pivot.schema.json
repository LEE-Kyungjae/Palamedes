{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/assumption-normalization-or-pivot.schema.json",
  "title": "PalamedesAssumptionNormalizationOrPivot",
  "description": "Experimental Cycle 245 contract normalizing assumptions or isolating one selection-changing pivot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assumption_review_id",
    "tournament_id",
    "candidate_ids",
    "assumptions",
    "resolution_mode",
    "pivotal_assumption_id",
    "pivotal_assumption_probe",
    "decision",
    "review_rationale"
  ],
  "properties": {
    "assumption_review_id": {"type": "string", "minLength": 1},
    "tournament_id": {"type": "string", "minLength": 1},
    "candidate_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assumption_id",
          "candidate_a_value",
          "candidate_b_value",
          "normalized",
          "normalized_value",
          "selection_changes_if_resolved"
        ],
        "properties": {
          "assumption_id": {"type": "string", "minLength": 1},
          "candidate_a_value": {"type": "string", "minLength": 1},
          "candidate_b_value": {"type": "string", "minLength": 1},
          "normalized": {"type": "boolean"},
          "normalized_value": {"type": "string"},
          "selection_changes_if_resolved": {"type": "boolean"}
        }
      }
    },
    "resolution_mode": {"enum": ["normalized", "isolate_pivotal"]},
    "pivotal_assumption_id": {"type": "string"},
    "pivotal_assumption_probe": {"type": "string"},
    "decision": {"enum": ["compare_candidates", "run_assumption_probe"]},
    "review_rationale": {"type": "string", "minLength": 1}
  }
}
