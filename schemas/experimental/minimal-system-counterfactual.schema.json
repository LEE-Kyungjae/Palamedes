{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/minimal-system-counterfactual.schema.json",
  "title": "PalamedesMinimalSystemCounterfactual",
  "description": "Experimental Cycle 154 absent, simpler, and full-system comparison.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluation_id",
    "mission_id",
    "fixed_input_signals_hash",
    "evaluation_protocol",
    "adequacy_threshold",
    "minimal_adequate_condition",
    "complexity_justification",
    "blind_evaluation",
    "conditions"
  ],
  "properties": {
    "evaluation_id": {"type": "string", "minLength": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "fixed_input_signals_hash": {"type": "string", "minLength": 1},
    "evaluation_protocol": {"type": "string", "minLength": 1},
    "adequacy_threshold": {"type": "string", "minLength": 1},
    "minimal_adequate_condition": {"enum": ["absent", "simpler", "full_palamedes"]},
    "complexity_justification": {"type": "string", "minLength": 1},
    "blind_evaluation": {"const": true},
    "conditions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "input_signals_hash",
          "system_description",
          "mission_output_hash",
          "owner_labor",
          "quality_observation",
          "reasoning_trace_hash"
        ],
        "properties": {
          "kind": {"enum": ["absent", "simpler", "full_palamedes"]},
          "input_signals_hash": {"type": "string", "minLength": 1},
          "system_description": {"type": "string", "minLength": 1},
          "mission_output_hash": {"type": "string", "minLength": 1},
          "owner_labor": {"type": "string", "minLength": 1},
          "quality_observation": {"type": "string", "minLength": 1},
          "reasoning_trace_hash": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
