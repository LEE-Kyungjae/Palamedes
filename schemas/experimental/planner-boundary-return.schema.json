{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/planner-boundary-return.schema.json",
  "title": "PalamedesPlannerBoundaryReturn",
  "description": "Experimental Cycle 173 typed planner return path across the mission boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "return_id",
    "mission_contract_id",
    "mission_contract_version",
    "planner_id",
    "return_kind",
    "discovery",
    "evidence_id",
    "affected_contract_field",
    "requested_response",
    "planner_unilaterally_revised_mission",
    "typed_details"
  ],
  "properties": {
    "return_id": {"type": "string", "minLength": 1},
    "mission_contract_id": {"type": "string", "minLength": 1},
    "mission_contract_version": {"type": "string", "minLength": 1},
    "planner_id": {"type": "string", "minLength": 1},
    "return_kind": {"enum": ["constraint_update", "thesis_challenge", "execution_alternative"]},
    "discovery": {"type": "string", "minLength": 1},
    "evidence_id": {"type": "string", "minLength": 1},
    "affected_contract_field": {"type": "string", "minLength": 1},
    "requested_response": {"type": "string", "minLength": 1},
    "planner_unilaterally_revised_mission": {"const": false},
    "typed_details": {"type": "object"}
  }
}
