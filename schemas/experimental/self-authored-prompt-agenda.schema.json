{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/self-authored-prompt-agenda.schema.json",
  "title": "Self-authored Bounded Research Prompt Agenda",
  "type": "object",
  "required": [
    "prompt_agenda_version",
    "prompt_agenda_id",
    "causal_cluster_id",
    "recurrence_count",
    "missing_cognitive_mode",
    "candidates",
    "critiques",
    "decision",
    "selected_prompt",
    "role_sequence",
    "call_budget",
    "stop_conditions",
    "rationale",
    "status",
    "constitutional_constraints_mutable",
    "delivery_authority_granted",
    "artifacts",
    "created_at"
  ],
  "properties": {
    "prompt_agenda_version": {"const": "palamedes-prompt-agenda/1"},
    "prompt_agenda_id": {"type": "string", "pattern": "^prompt-agenda-[a-f0-9]{12}$"},
    "causal_cluster_id": {"type": "string", "pattern": "^causal-cluster-[a-f0-9]{12}$"},
    "recurrence_count": {"type": "integer", "minimum": 2},
    "missing_cognitive_mode": {"type": "string", "minLength": 1},
    "candidates": {"type": "array", "minItems": 2},
    "critiques": {"type": "array", "minItems": 2},
    "decision": {"enum": ["select", "defer"]},
    "selected_prompt": {"type": ["object", "null"]},
    "role_sequence": {"type": "array", "items": {"type": "string"}},
    "call_budget": {"type": "integer", "minimum": 0, "maximum": 8},
    "stop_conditions": {"type": "array", "items": {"type": "string"}},
    "rationale": {"type": "string", "minLength": 1},
    "status": {"enum": ["selected", "deferred"]},
    "constitutional_constraints_mutable": {"const": false},
    "delivery_authority_granted": {"const": false},
    "artifacts": {"type": "array", "minItems": 3, "maxItems": 3},
    "created_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
