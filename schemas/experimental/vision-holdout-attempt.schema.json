{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/vision-holdout-attempt.schema.json",
  "title": "Palamedes Vision Holdout Attempt",
  "type": "object",
  "required": [
    "holdout_attempt_version",
    "attempt_id",
    "case_id",
    "case_fingerprint",
    "trial_number",
    "trial_id",
    "status",
    "started_at"
  ],
  "properties": {
    "holdout_attempt_version": {"const": "palamedes-vision-holdout-attempt/1"},
    "attempt_id": {"type": "string", "pattern": "^holdout-attempt-[a-f0-9]{12}$"},
    "case_id": {"type": "string", "pattern": "^holdout-[a-z0-9][a-z0-9-]{2,63}$"},
    "case_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "trial_number": {"type": "integer", "minimum": 1, "maximum": 3},
    "trial_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["started", "completed"]},
    "started_at": {"type": "string", "minLength": 1},
    "vision_benchmark_id": {"type": "string", "minLength": 1},
    "completed_at": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "completed"}}},
      "then": {"required": ["vision_benchmark_id", "completed_at"]}
    }
  ],
  "additionalProperties": false
}
