{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/summary-interpretation-evidence-boundary.schema.json",
  "title": "PalamedesSummaryInterpretationEvidenceBoundary",
  "description": "Cycle 339 summary provenance and original-evidence verification for high-consequence selection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["boundary_record_id", "selection_record_id", "selection_consequence", "summary_artifact", "decisive_evidence_citations", "summary_silently_substituted_for_raw_evidence", "original_access_logged", "boundary_rationale"],
  "properties": {
    "boundary_record_id": {"type": "string", "minLength": 1},
    "selection_record_id": {"type": "string", "minLength": 1},
    "selection_consequence": {"const": "high"},
    "summary_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["summary_id", "summary_fingerprint", "summary_text", "transform_record_id", "summarizer_runtime_fingerprint", "created_at", "source_evidence", "interpretive_choices", "omitted_details", "known_uncertainties", "epistemic_type", "equivalent_to_raw_evidence"],
      "properties": {
        "summary_id": {"type": "string", "minLength": 1},
        "summary_fingerprint": {"type": "string", "minLength": 1},
        "summary_text": {"type": "string", "minLength": 1},
        "transform_record_id": {"type": "string", "minLength": 1},
        "summarizer_runtime_fingerprint": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1},
        "source_evidence": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["evidence_id", "evidence_fingerprint", "provenance_record_id", "controlled_original_locator", "raw_content_embedded"],
            "properties": {
              "evidence_id": {"type": "string", "minLength": 1},
              "evidence_fingerprint": {"type": "string", "minLength": 1},
              "provenance_record_id": {"type": "string", "minLength": 1},
              "controlled_original_locator": {"type": "string", "minLength": 1},
              "raw_content_embedded": {"const": false}
            }
          }
        },
        "interpretive_choices": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "omitted_details": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "known_uncertainties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "epistemic_type": {"const": "interpretation"},
        "equivalent_to_raw_evidence": {"const": false}
      }
    },
    "decisive_evidence_citations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["citation_id", "evidence_id", "evidence_fingerprint", "original_access_receipt_id", "verified_at", "decision_effect", "original_evidence_verified", "summary_used_as_sole_evidence"],
        "properties": {
          "citation_id": {"type": "string", "minLength": 1},
          "evidence_id": {"type": "string", "minLength": 1},
          "evidence_fingerprint": {"type": "string", "minLength": 1},
          "original_access_receipt_id": {"type": "string", "minLength": 1},
          "verified_at": {"type": "string", "minLength": 1},
          "decision_effect": {"type": "string", "minLength": 1},
          "original_evidence_verified": {"const": true},
          "summary_used_as_sole_evidence": {"const": false}
        }
      }
    },
    "summary_silently_substituted_for_raw_evidence": {"const": false},
    "original_access_logged": {"const": true},
    "boundary_rationale": {"type": "string", "minLength": 1}
  }
}
