{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/governed-mission-contract-issue.schema.json",
  "title": "PalamedesGovernedMissionContractIssue",
  "description": "Experimental Cycle 318 contract issue requiring committed selection, tournament, and constitutional trace.",
  "type": "object",
  "additionalProperties": false,
  "required": ["issue_command_id", "selection_record_id", "selection_record_fingerprint", "selection_decision", "mission_tournament_id", "mission_tournament_fingerprint", "selected_mission_candidate_id", "selected_candidate_fingerprint", "issue_authority_id", "constitutional_trace", "mission_contract", "constitutional_trace_verified", "free_form_issue_allowed", "tournament_bypassed", "issue_rationale"],
  "properties": {
    "issue_command_id": {"type": "string", "minLength": 1},
    "selection_record_id": {"type": "string", "minLength": 1},
    "selection_record_fingerprint": {"type": "string", "minLength": 1},
    "selection_decision": {"const": "commit"},
    "mission_tournament_id": {"type": "string", "minLength": 1},
    "mission_tournament_fingerprint": {"type": "string", "minLength": 1},
    "selected_mission_candidate_id": {"type": "string", "minLength": 1},
    "selected_candidate_fingerprint": {"type": "string", "minLength": 1},
    "issue_authority_id": {"type": "string", "minLength": 1},
    "constitutional_trace": {
      "type": "object", "additionalProperties": false,
      "required": ["constitutional_interpretation_id", "constitution_state_id", "constitution_fingerprint", "clause_applications", "trace_rationale"],
      "properties": {
        "constitutional_interpretation_id": {"type": "string", "minLength": 1},
        "constitution_state_id": {"type": "string", "minLength": 1},
        "constitution_fingerprint": {"type": "string", "minLength": 1},
        "clause_applications": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["clause_id", "interpretation", "selection_effect", "authority_source_id", "precedent_ids"],
            "properties": {
              "clause_id": {"type": "string", "minLength": 1},
              "interpretation": {"type": "string", "minLength": 1},
              "selection_effect": {"type": "string", "minLength": 1},
              "authority_source_id": {"type": "string", "minLength": 1},
              "precedent_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "trace_rationale": {"type": "string", "minLength": 1}
      }
    },
    "mission_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["mission_contract_id", "mission_candidate_id", "selection_record_id", "constitutional_interpretation_id", "version", "contract_fingerprint", "situation", "meaning", "beneficiary", "desired_external_condition", "essential_causal_mechanism", "non_goal", "success_signal", "disconfirmation_condition", "authority_return_trigger", "issued_at"],
      "properties": {
        "mission_contract_id": {"type": "string", "minLength": 1},
        "mission_candidate_id": {"type": "string", "minLength": 1},
        "selection_record_id": {"type": "string", "minLength": 1},
        "constitutional_interpretation_id": {"type": "string", "minLength": 1},
        "version": {"const": 1},
        "contract_fingerprint": {"type": "string", "minLength": 1},
        "situation": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1},
        "beneficiary": {"type": "string", "minLength": 1},
        "desired_external_condition": {"type": "string", "minLength": 1},
        "essential_causal_mechanism": {"type": "string", "minLength": 1},
        "non_goal": {"type": "string", "minLength": 1},
        "success_signal": {"type": "string", "minLength": 1},
        "disconfirmation_condition": {"type": "string", "minLength": 1},
        "authority_return_trigger": {"type": "string", "minLength": 1},
        "issued_at": {"type": "string", "minLength": 1}
      }
    },
    "constitutional_trace_verified": {"const": true},
    "free_form_issue_allowed": {"const": false},
    "tournament_bypassed": {"const": false},
    "issue_rationale": {"type": "string", "minLength": 1}
  }
}
