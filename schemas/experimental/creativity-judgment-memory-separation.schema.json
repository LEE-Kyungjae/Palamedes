{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/creativity-judgment-memory-separation.schema.json",
  "title": "PalamedesCreativityJudgmentMemorySeparation",
  "description": "Experimental Cycle 293 separation of invention, constitutional selection, and continuity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["separation_record_id", "mission_artifact_id", "constitution_snapshot_id", "role_contributions", "invented_candidate_ids", "candidate_set_artifact_id", "selected_mission_id", "selection_record_id", "continuity_record_ids", "continuity_bundle_id", "roles_may_override_each_other", "separation_rationale"],
  "properties": {
    "separation_record_id": {"type": "string", "minLength": 1},
    "mission_artifact_id": {"type": "string", "minLength": 1},
    "constitution_snapshot_id": {"type": "string", "minLength": 1},
    "role_contributions": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "sole_responsibility", "input_artifact_id", "output_artifact_id", "prohibited_actions", "contribution_rationale"],
        "properties": {
          "role": {"enum": ["creativity", "judgment", "memory"]},
          "sole_responsibility": {"enum": ["independent_mission_invention", "constitutional_mission_selection", "causal_and_normative_continuity"]},
          "input_artifact_id": {"type": "string", "minLength": 1},
          "output_artifact_id": {"type": "string", "minLength": 1},
          "prohibited_actions": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "contribution_rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "invented_candidate_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "candidate_set_artifact_id": {"type": "string", "minLength": 1},
    "selected_mission_id": {"type": "string", "minLength": 1},
    "selection_record_id": {"type": "string", "minLength": 1},
    "continuity_record_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "continuity_bundle_id": {"type": "string", "minLength": 1},
    "roles_may_override_each_other": {"const": false},
    "separation_rationale": {"type": "string", "minLength": 1}
  }
}
