{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/adversarial-axis-sensitivity-review.schema.json",
  "title": "PalamedesAdversarialAxisSensitivityReview",
  "description": "Cycle 345 adversarial plural-axis review and sensitivity ranges for non-dominated candidates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_set_id", "non_dominated_frontier_fingerprint", "non_dominated_candidate_ids", "adversarial_axes", "candidate_reviews", "aggregate_numerical_score_present", "axis_tradeoffs_collapsed", "sensitivity_ranges_visible_to_selector", "review_rationale"],
  "properties": {
    "review_set_id": {"type": "string", "minLength": 1},
    "non_dominated_frontier_fingerprint": {"type": "string", "minLength": 1},
    "non_dominated_candidate_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "adversarial_axes": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "candidate_reviews": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "axis_reviews", "review_fingerprint"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "axis_reviews": {
            "type": "array", "minItems": 3,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["axis", "adversarial_question", "finding", "supporting_evidence_ids", "opposing_evidence_ids", "worst_case_condition", "failure_signal", "sensitivity_range"],
              "properties": {
                "axis": {"type": "string", "minLength": 1},
                "adversarial_question": {"type": "string", "minLength": 1},
                "finding": {"type": "string", "minLength": 1},
                "supporting_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "opposing_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "worst_case_condition": {"type": "string", "minLength": 1},
                "failure_signal": {"type": "string", "minLength": 1},
                "sensitivity_range": {
                  "type": "object", "additionalProperties": false,
                  "required": ["sensitivity_id", "assumption_id", "lower_bound", "upper_bound", "outcome_at_lower_bound", "outcome_at_upper_bound", "selection_flip_threshold", "fragile"],
                  "properties": {
                    "sensitivity_id": {"type": "string", "minLength": 1},
                    "assumption_id": {"type": "string", "minLength": 1},
                    "lower_bound": {"type": "string", "minLength": 1},
                    "upper_bound": {"type": "string", "minLength": 1},
                    "outcome_at_lower_bound": {"type": "string", "minLength": 1},
                    "outcome_at_upper_bound": {"type": "string", "minLength": 1},
                    "selection_flip_threshold": {"type": "string", "minLength": 1},
                    "fragile": {"type": "boolean"}
                  }
                }
              }
            }
          },
          "review_fingerprint": {"type": "string", "minLength": 1}
        }
      }
    },
    "aggregate_numerical_score_present": {"const": false},
    "axis_tradeoffs_collapsed": {"const": false},
    "sensitivity_ranges_visible_to_selector": {"const": true},
    "review_rationale": {"type": "string", "minLength": 1}
  }
}
