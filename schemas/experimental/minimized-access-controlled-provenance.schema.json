{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/minimized-access-controlled-provenance.schema.json",
  "title": "PalamedesMinimizedAccessControlledProvenance",
  "description": "Experimental Cycle 279 provenance with data minimization, access control, retention, and hash-only commitments for restricted content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provenance_policy_id",
    "audit_log_id",
    "raw_sensitive_beneficiary_identifiers_logged",
    "provenance_records",
    "access_events",
    "policy_rationale"
  ],
  "properties": {
    "provenance_policy_id": {"type": "string", "minLength": 1},
    "audit_log_id": {"type": "string", "minLength": 1},
    "raw_sensitive_beneficiary_identifiers_logged": {"const": false},
    "provenance_records": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "provenance_kind",
          "collection_necessity",
          "minimization_rationale",
          "omitted_fields",
          "sensitivity",
          "storage_mode",
          "stored_content",
          "content_hash",
          "allowed_role_ids",
          "retention_until",
          "expiry_action"
        ],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "provenance_kind": {"type": "string", "minLength": 1},
          "collection_necessity": {"type": "string", "minLength": 1},
          "minimization_rationale": {"type": "string", "minLength": 1},
          "omitted_fields": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
          "storage_mode": {"enum": ["minimized_content", "hash_only"]},
          "stored_content": {"type": "string"},
          "content_hash": {"type": "string", "minLength": 1},
          "allowed_role_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "retention_until": {"type": "string", "minLength": 1},
          "expiry_action": {"type": "string", "minLength": 1}
        }
      }
    },
    "access_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["access_id", "record_id", "requester_role_id", "requested_at", "decision"],
        "properties": {
          "access_id": {"type": "string", "minLength": 1},
          "record_id": {"type": "string", "minLength": 1},
          "requester_role_id": {"type": "string", "minLength": 1},
          "requested_at": {"type": "string", "minLength": 1},
          "decision": {"enum": ["allow", "deny"]}
        }
      }
    },
    "policy_rationale": {"type": "string", "minLength": 1}
  }
}
