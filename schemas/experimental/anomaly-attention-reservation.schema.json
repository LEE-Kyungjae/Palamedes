{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/anomaly-attention-reservation.schema.json",
  "title": "PalamedesAnomalyAttentionReservation",
  "description": "Experimental Cycle 203 bounded attention for observations outside current value and world models.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reservation_id",
    "event_id",
    "anomalous_observation",
    "observation_evidence_id",
    "current_value_model_id",
    "current_world_model_id",
    "value_model_fit",
    "world_model_fit",
    "value_model_mismatch",
    "world_model_mismatch",
    "anomaly_budget_id",
    "anomaly_capacity",
    "anomaly_committed",
    "anomaly_cost",
    "expires_at",
    "meaning_assigned_before_investigation",
    "anomaly_is_harm_evidence",
    "investigation_probe",
    "decision",
    "decision_rationale"
  ],
  "properties": {
    "reservation_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "anomalous_observation": {"type": "string", "minLength": 1},
    "observation_evidence_id": {"type": "string", "minLength": 1},
    "current_value_model_id": {"type": "string", "minLength": 1},
    "current_world_model_id": {"type": "string", "minLength": 1},
    "value_model_fit": {"const": false},
    "world_model_fit": {"const": false},
    "value_model_mismatch": {"type": "string", "minLength": 1},
    "world_model_mismatch": {"type": "string", "minLength": 1},
    "anomaly_budget_id": {"type": "string", "minLength": 1},
    "anomaly_capacity": {"type": "number", "minimum": 0},
    "anomaly_committed": {"type": "number", "minimum": 0},
    "anomaly_cost": {"type": "number", "exclusiveMinimum": 0},
    "expires_at": {"type": "string", "minLength": 1},
    "meaning_assigned_before_investigation": {"const": false},
    "anomaly_is_harm_evidence": {"const": false},
    "investigation_probe": {"type": "string", "minLength": 1},
    "decision": {"enum": ["reserve", "defer", "reject"]},
    "decision_rationale": {"type": "string", "minLength": 1}
  }
}
