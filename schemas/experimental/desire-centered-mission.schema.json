{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/desire-centered-mission.schema.json",
  "title": "PalamedesDesireCenteredMission",
  "description": "Experimental Cycle 120 mission centered on human capability or condition change.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id",
    "beneficiary_group_id",
    "current_condition",
    "desired_condition",
    "capability_change",
    "change_mechanism",
    "demand_evidence_role",
    "value_state_id",
    "constitution_id",
    "desire_model_id",
    "disconfirming_condition",
    "demand_defines_mission",
    "revenue_defines_success",
    "demand_evidence_ids",
    "beneficiary_change_signals",
    "safeguards"
  ],
  "properties": {
    "mission_id": {"type": "string", "minLength": 1},
    "beneficiary_group_id": {"type": "string", "minLength": 1},
    "current_condition": {"type": "string", "minLength": 1},
    "desired_condition": {"type": "string", "minLength": 1},
    "capability_change": {"type": "string", "minLength": 1},
    "change_mechanism": {"type": "string", "minLength": 1},
    "demand_evidence_role": {"type": "string", "minLength": 1},
    "value_state_id": {"type": "string", "minLength": 1},
    "constitution_id": {"type": "string", "minLength": 1},
    "desire_model_id": {"type": "string", "minLength": 1},
    "disconfirming_condition": {"type": "string", "minLength": 1},
    "demand_defines_mission": {"const": false},
    "revenue_defines_success": {"const": false},
    "demand_evidence_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "beneficiary_change_signals": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 1}
    },
    "safeguards": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
