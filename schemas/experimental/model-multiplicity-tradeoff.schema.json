{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/model-multiplicity-tradeoff.schema.json",
  "title": "PalamedesModelMultiplicityTradeoff",
  "description": "Cycle 321 comparison of single-model coherence against multi-model diversity, reproducibility, and cost.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tradeoff_id", "cognitive_case_id", "frozen_input_fingerprint", "conditions", "same_task_and_input", "same_non_model_budget", "diversity_assumed_better", "cost_ignored", "reproducibility_ignored", "selection_rule", "evaluation_rationale"],
  "properties": {
    "tradeoff_id": {"type": "string", "minLength": 1},
    "cognitive_case_id": {"type": "string", "minLength": 1},
    "frozen_input_fingerprint": {"type": "string", "minLength": 1},
    "conditions": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["condition_id", "mode", "input_fingerprint", "assignment_manifest_id", "assignment_manifest_fingerprint", "output_artifact_id", "model_calls", "resource_ledger", "frame_diversity_score", "cross_run_reproducibility_score", "measurement_method"],
        "properties": {
          "condition_id": {"type": "string", "minLength": 1},
          "mode": {"enum": ["single_model", "multi_model"]},
          "input_fingerprint": {"type": "string", "minLength": 1},
          "assignment_manifest_id": {"type": "string", "minLength": 1},
          "assignment_manifest_fingerprint": {"type": "string", "minLength": 1},
          "output_artifact_id": {"type": "string", "minLength": 1},
          "model_calls": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["call_id", "model_id", "provider_id", "prompt_fingerprint", "response_fingerprint", "token_count", "cost_usd"],
              "properties": {
                "call_id": {"type": "string", "minLength": 1},
                "model_id": {"type": "string", "minLength": 1},
                "provider_id": {"type": "string", "minLength": 1},
                "prompt_fingerprint": {"type": "string", "minLength": 1},
                "response_fingerprint": {"type": "string", "minLength": 1},
                "token_count": {"type": "integer", "minimum": 1},
                "cost_usd": {"type": "number", "minimum": 0}
              }
            }
          },
          "resource_ledger": {
            "type": "object", "additionalProperties": false,
            "required": ["total_calls", "total_tokens", "total_cost_usd"],
            "properties": {
              "total_calls": {"type": "integer", "minimum": 1},
              "total_tokens": {"type": "integer", "minimum": 1},
              "total_cost_usd": {"type": "number", "minimum": 0}
            }
          },
          "frame_diversity_score": {"type": "number", "minimum": 0, "maximum": 1},
          "cross_run_reproducibility_score": {"type": "number", "minimum": 0, "maximum": 1},
          "measurement_method": {"type": "string", "minLength": 1}
        }
      }
    },
    "same_task_and_input": {"const": true},
    "same_non_model_budget": {"const": true},
    "diversity_assumed_better": {"const": false},
    "cost_ignored": {"const": false},
    "reproducibility_ignored": {"const": false},
    "selection_rule": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_diversity_gain", "maximum_cost_multiplier", "minimum_reproducibility", "fallback"],
      "properties": {
        "minimum_diversity_gain": {"type": "number", "minimum": 0},
        "maximum_cost_multiplier": {"type": "number", "minimum": 0},
        "minimum_reproducibility": {"type": "number", "minimum": 0},
        "fallback": {"type": "string", "minLength": 1}
      }
    },
    "evaluation_rationale": {"type": "string", "minLength": 1}
  }
}
