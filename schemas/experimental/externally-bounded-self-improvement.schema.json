{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/externally-bounded-self-improvement.schema.json",
  "title": "PalamedesExternallyBoundedSelfImprovement",
  "description": "Experimental Cycle 152 self-improvement justified and bounded by an external mission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "improvement_id",
    "external_mission_id",
    "external_beneficiary_group_id",
    "capability_change",
    "mission_dependency",
    "counterfactual_without_improvement",
    "independent_bound_id",
    "independent_bound_owner",
    "scope",
    "valid_until",
    "rollback",
    "success_signal",
    "stop_condition",
    "self_improvement_is_independent_mission",
    "may_expand_authority",
    "external_beneficiary_evidence_ids",
    "resource_limit",
    "resource_unit"
  ],
  "properties": {
    "improvement_id": {"type": "string", "minLength": 1},
    "external_mission_id": {"type": "string", "minLength": 1},
    "external_beneficiary_group_id": {"type": "string", "minLength": 1},
    "capability_change": {"type": "string", "minLength": 1},
    "mission_dependency": {"type": "string", "minLength": 1},
    "counterfactual_without_improvement": {"type": "string", "minLength": 1},
    "independent_bound_id": {"type": "string", "minLength": 1},
    "independent_bound_owner": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "valid_until": {"type": "string", "minLength": 1},
    "rollback": {"type": "string", "minLength": 1},
    "success_signal": {"type": "string", "minLength": 1},
    "stop_condition": {"type": "string", "minLength": 1},
    "self_improvement_is_independent_mission": {"const": false},
    "may_expand_authority": {"const": false},
    "external_beneficiary_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "resource_limit": {"type": "integer", "minimum": 0},
    "resource_unit": {"type": "string", "minLength": 1}
  }
}
