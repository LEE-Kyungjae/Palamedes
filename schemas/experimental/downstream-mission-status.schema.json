{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/downstream-mission-status.schema.json",
  "title": "PalamedesDownstreamMissionStatus",
  "description": "Experimental Cycle 176 downstream status combining delivery, retired uncertainty, and observed consequence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status_id",
    "mission_contract_id",
    "mission_contract_version",
    "planner_id",
    "delivery_status",
    "delivery_summary",
    "delivery_evidence_id",
    "delivery_completion_substitutes_for_outcome",
    "uncertainty_updates",
    "observed_consequences",
    "next_observation"
  ],
  "properties": {
    "status_id": {"type": "string", "minLength": 1},
    "mission_contract_id": {"type": "string", "minLength": 1},
    "mission_contract_version": {"type": "string", "minLength": 1},
    "planner_id": {"type": "string", "minLength": 1},
    "delivery_status": {"enum": ["not_started", "in_progress", "completed", "blocked"]},
    "delivery_summary": {"type": "string", "minLength": 1},
    "delivery_evidence_id": {"type": "string", "minLength": 1},
    "delivery_completion_substitutes_for_outcome": {"const": false},
    "uncertainty_updates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uncertainty_id", "question", "status", "observation", "evidence_id"],
        "properties": {
          "uncertainty_id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "status": {"enum": ["retired", "reduced", "unchanged", "expanded"]},
          "observation": {"type": "string", "minLength": 1},
          "evidence_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "observed_consequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "consequence_id",
          "kind",
          "affected_party",
          "observation",
          "observed_at",
          "evidence_id"
        ],
        "properties": {
          "consequence_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["benefit", "harm", "neutral", "uncertain"]},
          "affected_party": {"type": "string", "minLength": 1},
          "observation": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "minLength": 1},
          "evidence_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "next_observation": {"type": "string", "minLength": 1}
  }
}
