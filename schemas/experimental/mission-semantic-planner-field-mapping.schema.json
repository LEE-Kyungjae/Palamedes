{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/mission-semantic-planner-field-mapping.schema.json",
  "title": "PalamedesMissionSemanticPlannerFieldMapping",
  "description": "Cycle 352 exact semantic mapping from a mission contract into planner fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mapping_id", "compilation_id", "source_mission_contract_id", "source_mission_contract_fingerprint", "mapping_fingerprint", "source_semantics", "planner_fields", "source_semantics_fully_covered", "unmapped_source_semantics", "execution_form_generated", "mapping_rationale"],
  "properties": {
    "mapping_id": {"type": "string", "minLength": 1},
    "compilation_id": {"type": "string", "minLength": 1},
    "source_mission_contract_id": {"type": "string", "minLength": 1},
    "source_mission_contract_fingerprint": {"type": "string", "minLength": 1},
    "mapping_fingerprint": {"type": "string", "minLength": 1},
    "source_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission_outcome", "success_signals", "harm_signals", "causal_thesis", "non_goals"],
      "properties": {
        "mission_outcome": {"$ref": "#/$defs/sourceValue"},
        "success_signals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceSignal"}},
        "harm_signals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceSignal"}},
        "causal_thesis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_field_pointer", "statement", "value_fingerprint"],
          "properties": {
            "source_field_pointer": {"type": "string", "minLength": 1},
            "statement": {"type": "string", "minLength": 1},
            "value_fingerprint": {"type": "string", "minLength": 1}
          }
        },
        "non_goals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceNonGoal"}}
      }
    },
    "planner_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "success_metrics", "harm_metrics", "constraints", "explicit_exclusions", "tasks", "implementation_sequence"],
      "properties": {
        "goal": {"$ref": "#/$defs/goal"},
        "success_metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/successMetric"}},
        "harm_metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/harmMetric"}},
        "constraints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/causalConstraint"}},
        "explicit_exclusions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonGoalExclusion"}},
        "tasks": {"type": "array", "maxItems": 0},
        "implementation_sequence": {"type": "array", "maxItems": 0}
      }
    },
    "source_semantics_fully_covered": {"const": true},
    "unmapped_source_semantics": {"type": "array", "maxItems": 0},
    "execution_form_generated": {"const": false},
    "mapping_rationale": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sourceValue": {
      "type": "object", "additionalProperties": false,
      "required": ["source_field_pointer", "value", "value_fingerprint"],
      "properties": {
        "source_field_pointer": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "value_fingerprint": {"type": "string", "minLength": 1}
      }
    },
    "sourceSignal": {
      "type": "object", "additionalProperties": false,
      "required": ["signal_id", "source_field_pointer", "value", "value_fingerprint"],
      "properties": {
        "signal_id": {"type": "string", "minLength": 1},
        "source_field_pointer": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "value_fingerprint": {"type": "string", "minLength": 1}
      }
    },
    "sourceNonGoal": {
      "type": "object", "additionalProperties": false,
      "required": ["non_goal_id", "source_field_pointer", "value", "value_fingerprint"],
      "properties": {
        "non_goal_id": {"type": "string", "minLength": 1},
        "source_field_pointer": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "value_fingerprint": {"type": "string", "minLength": 1}
      }
    },
    "goal": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "source_field_pointer", "source_value_fingerprint"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "source_field_pointer": {"type": "string", "minLength": 1},
        "source_value_fingerprint": {"type": "string", "minLength": 1}
      }
    },
    "mappedBase": {
      "type": "object",
      "required": ["compiled_field_id", "text", "source_field_pointer", "source_value_fingerprint", "semantic_kind"],
      "properties": {
        "compiled_field_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "source_field_pointer": {"type": "string", "minLength": 1},
        "source_value_fingerprint": {"type": "string", "minLength": 1}
      }
    },
    "successMetric": {
      "allOf": [
        {"$ref": "#/$defs/mappedBase"},
        {"type": "object", "additionalProperties": false, "required": ["compiled_field_id", "source_signal_id", "text", "source_field_pointer", "source_value_fingerprint", "semantic_kind"], "properties": {
          "compiled_field_id": {"type": "string", "minLength": 1}, "source_signal_id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "source_field_pointer": {"type": "string", "minLength": 1}, "source_value_fingerprint": {"type": "string", "minLength": 1}, "semantic_kind": {"const": "success_metric"}
        }}
      ]
    },
    "harmMetric": {
      "type": "object", "additionalProperties": false,
      "required": ["compiled_field_id", "source_signal_id", "text", "source_field_pointer", "source_value_fingerprint", "semantic_kind"],
      "properties": {
        "compiled_field_id": {"type": "string", "minLength": 1}, "source_signal_id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "source_field_pointer": {"type": "string", "minLength": 1}, "source_value_fingerprint": {"type": "string", "minLength": 1}, "semantic_kind": {"const": "harm_metric"}
      }
    },
    "causalConstraint": {
      "type": "object", "additionalProperties": false,
      "required": ["compiled_field_id", "source_causal_thesis_id", "text", "source_field_pointer", "source_value_fingerprint", "semantic_kind"],
      "properties": {
        "compiled_field_id": {"type": "string", "minLength": 1}, "source_causal_thesis_id": {"const": "causal_thesis"}, "text": {"type": "string", "minLength": 1}, "source_field_pointer": {"type": "string", "minLength": 1}, "source_value_fingerprint": {"type": "string", "minLength": 1}, "semantic_kind": {"const": "causal_constraint"}
      }
    },
    "nonGoalExclusion": {
      "type": "object", "additionalProperties": false,
      "required": ["compiled_field_id", "source_non_goal_id", "text", "source_field_pointer", "source_value_fingerprint", "semantic_kind"],
      "properties": {
        "compiled_field_id": {"type": "string", "minLength": 1}, "source_non_goal_id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "source_field_pointer": {"type": "string", "minLength": 1}, "source_value_fingerprint": {"type": "string", "minLength": 1}, "semantic_kind": {"const": "non_goal_exclusion"}
      }
    }
  }
}
