{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/bounded-context-leakage-guard.schema.json",
  "title": "PalamedesBoundedContextLeakageGuard",
  "description": "Cycle 331 context budget and leakage guard for independent mission generation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["context_guard_id", "generation_assignment_id", "available_universe_fingerprint", "context_manifest_fingerprint", "available_universe_tokens", "context_token_budget", "selected_context_tokens", "included_artifacts", "excluded_categories", "leakage_scan", "entire_repository_included", "entire_history_included", "independent_generation_preserved", "guard_rationale"],
  "properties": {
    "context_guard_id": {"type": "string", "minLength": 1},
    "generation_assignment_id": {"type": "string", "minLength": 1},
    "available_universe_fingerprint": {"type": "string", "minLength": 1},
    "context_manifest_fingerprint": {"type": "string", "minLength": 1},
    "available_universe_tokens": {"type": "integer", "minimum": 1},
    "context_token_budget": {"type": "integer", "minimum": 1},
    "selected_context_tokens": {"type": "integer", "minimum": 1},
    "included_artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "artifact_type", "content_fingerprint", "inclusion_reason", "source_provenance_id", "token_count", "contains_prior_mission_conclusion", "contains_persuasive_discussion_history"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "artifact_type": {"enum": ["observation", "constitution_clause", "causal_evidence", "active_constraint"]},
          "content_fingerprint": {"type": "string", "minLength": 1},
          "inclusion_reason": {"type": "string", "minLength": 1},
          "source_provenance_id": {"type": "string", "minLength": 1},
          "token_count": {"type": "integer", "minimum": 1},
          "contains_prior_mission_conclusion": {"const": false},
          "contains_persuasive_discussion_history": {"const": false}
        }
      }
    },
    "excluded_categories": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"enum": ["full_repository_dump", "full_history_dump", "prior_mission_candidates", "prior_selection_conclusions", "persuasive_discussion_history", "raw_chain_of_thought"]}},
    "leakage_scan": {
      "type": "object", "additionalProperties": false,
      "required": ["scan_id", "scanner_version", "scanned_context_fingerprint", "scanned_at", "prior_conclusion_matches", "forbidden_category_matches", "passed"],
      "properties": {
        "scan_id": {"type": "string", "minLength": 1},
        "scanner_version": {"type": "string", "minLength": 1},
        "scanned_context_fingerprint": {"type": "string", "minLength": 1},
        "scanned_at": {"type": "string", "minLength": 1},
        "prior_conclusion_matches": {"type": "array", "maxItems": 0},
        "forbidden_category_matches": {"type": "array", "maxItems": 0},
        "passed": {"const": true}
      }
    },
    "entire_repository_included": {"const": false},
    "entire_history_included": {"const": false},
    "independent_generation_preserved": {"const": true},
    "guard_rationale": {"type": "string", "minLength": 1}
  }
}
