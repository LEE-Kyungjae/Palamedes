{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/falsifiable-implementation-open-mission.schema.json",
  "title": "PalamedesFalsifiableImplementationOpenMission",
  "description": "Experimental Cycle 238 contract making missions falsifiable without selecting implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_contract_id",
    "mission_candidate_id",
    "external_beneficiary",
    "current_condition",
    "target_condition",
    "outcome_measure",
    "success_threshold",
    "evaluation_window",
    "failure_condition",
    "mission_is_mechanism_agnostic",
    "selected_implementation_id",
    "reachable_mechanism_classes",
    "implementation_invariants",
    "prohibited_consequences",
    "mechanism_selection_gate"
  ],
  "properties": {
    "mission_contract_id": {"type": "string", "minLength": 1},
    "mission_candidate_id": {"type": "string", "minLength": 1},
    "external_beneficiary": {"type": "string", "minLength": 1},
    "current_condition": {"type": "string", "minLength": 1},
    "target_condition": {"type": "string", "minLength": 1},
    "outcome_measure": {"type": "string", "minLength": 1},
    "success_threshold": {"type": "string", "minLength": 1},
    "evaluation_window": {"type": "string", "minLength": 1},
    "failure_condition": {"type": "string", "minLength": 1},
    "mission_is_mechanism_agnostic": {"const": true},
    "selected_implementation_id": {"type": "string", "maxLength": 0},
    "reachable_mechanism_classes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "implementation_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "prohibited_consequences": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "mechanism_selection_gate": {"type": "string", "minLength": 1}
  }
}
