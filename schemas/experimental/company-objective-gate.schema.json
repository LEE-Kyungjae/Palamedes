{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/company-objective-gate.schema.json",
  "title": "PalamedesCompanyObjectiveGate",
  "description": "Experimental Cycle 190 durable beneficiary change and renewable option capacity under constitutional constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective_gate_id",
    "portfolio_id",
    "beneficiary_first_review_id",
    "revenue_role_review_id",
    "resource_renewal_id",
    "growth_mechanism_audit_id",
    "exploration_charge_id",
    "coordination_metrics_id",
    "minority_expiry_id",
    "environmental_principle_review_id",
    "constitution_governance_id",
    "constitution_id",
    "constitution_version",
    "durable_beneficiary_change",
    "beneficiary_change_evidence_id",
    "beneficiary_change_is_durable",
    "renewable_option_capacity",
    "option_capacity_evidence_id",
    "option_capacity_is_renewable",
    "revenue_evidence_id",
    "execution_evidence_id",
    "revenue_is_company_objective",
    "execution_is_company_objective",
    "scalar_maximization_objective",
    "constitutional_constraints",
    "decision",
    "decision_rationale"
  ],
  "properties": {
    "objective_gate_id": {"type": "string", "minLength": 1},
    "portfolio_id": {"type": "string", "minLength": 1},
    "beneficiary_first_review_id": {"type": "string", "minLength": 1},
    "revenue_role_review_id": {"type": "string", "minLength": 1},
    "resource_renewal_id": {"type": "string", "minLength": 1},
    "growth_mechanism_audit_id": {"type": "string", "minLength": 1},
    "exploration_charge_id": {"type": "string", "minLength": 1},
    "coordination_metrics_id": {"type": "string", "minLength": 1},
    "minority_expiry_id": {"type": "string", "minLength": 1},
    "environmental_principle_review_id": {"type": "string", "minLength": 1},
    "constitution_governance_id": {"type": "string", "minLength": 1},
    "constitution_id": {"type": "string", "minLength": 1},
    "constitution_version": {"type": "string", "minLength": 1},
    "durable_beneficiary_change": {"type": "string", "minLength": 1},
    "beneficiary_change_evidence_id": {"type": "string", "minLength": 1},
    "beneficiary_change_is_durable": {"const": true},
    "renewable_option_capacity": {"type": "string", "minLength": 1},
    "option_capacity_evidence_id": {"type": "string", "minLength": 1},
    "option_capacity_is_renewable": {"const": true},
    "revenue_evidence_id": {"type": "string", "minLength": 1},
    "execution_evidence_id": {"type": "string", "minLength": 1},
    "revenue_is_company_objective": {"const": false},
    "execution_is_company_objective": {"const": false},
    "scalar_maximization_objective": {"const": false},
    "constitutional_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clause_id", "application", "evidence_id", "satisfied"],
        "properties": {
          "clause_id": {"type": "string", "minLength": 1},
          "application": {"type": "string", "minLength": 1},
          "evidence_id": {"type": "string", "minLength": 1},
          "satisfied": {"type": "boolean"}
        }
      }
    },
    "decision": {"enum": ["continue", "revise", "stop"]},
    "decision_rationale": {"type": "string", "minLength": 1}
  }
}
