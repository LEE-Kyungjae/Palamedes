{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/reference-evidence-authority-boundary.schema.json",
  "title": "PalamedesReferenceEvidenceAuthorityBoundary",
  "description": "Experimental Cycle 272 boundary treating reference content as evidence while quarantining embedded instructions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference_review_id",
    "reference_id",
    "reference_source",
    "content_hash",
    "reference_role",
    "reference_can_issue_instructions",
    "reference_can_amend_constitution",
    "constitutional_guidance_taken_directly_from_reference",
    "evidence_claims",
    "embedded_instructions",
    "constitution_id",
    "constitutional_clause_id",
    "authorized_interpreter_id",
    "constitutional_application_evidence_ids",
    "review_rationale"
  ],
  "properties": {
    "reference_review_id": {"type": "string", "minLength": 1},
    "reference_id": {"type": "string", "minLength": 1},
    "reference_source": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "minLength": 1},
    "reference_role": {"const": "evidence_only"},
    "reference_can_issue_instructions": {"const": false},
    "reference_can_amend_constitution": {"const": false},
    "constitutional_guidance_taken_directly_from_reference": {"const": false},
    "evidence_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim", "content_locator", "evidence_id", "treated_as_instruction"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "content_locator": {"type": "string", "minLength": 1},
          "evidence_id": {"type": "string", "minLength": 1},
          "treated_as_instruction": {"const": false}
        }
      }
    },
    "embedded_instructions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instruction_id",
          "directive",
          "content_locator",
          "classification",
          "quarantined",
          "executed"
        ],
        "properties": {
          "instruction_id": {"type": "string", "minLength": 1},
          "directive": {"type": "string", "minLength": 1},
          "content_locator": {"type": "string", "minLength": 1},
          "classification": {"type": "string", "minLength": 1},
          "quarantined": {"const": true},
          "executed": {"const": false}
        }
      }
    },
    "constitution_id": {"type": "string", "minLength": 1},
    "constitutional_clause_id": {"type": "string", "minLength": 1},
    "authorized_interpreter_id": {"type": "string", "minLength": 1},
    "constitutional_application_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "review_rationale": {"type": "string", "minLength": 1}
  }
}
