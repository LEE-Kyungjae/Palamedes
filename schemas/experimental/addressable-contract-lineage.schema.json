{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/addressable-contract-lineage.schema.json",
  "title": "PalamedesAddressableContractLineage",
  "description": "Experimental Cycle 259 index linking concise contract claims to full immutable signals, interpretations, alternatives, and constitution traces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lineage_index_id",
    "planner_contract_id",
    "lineage_store_id",
    "claim_max_characters",
    "full_lineage_embedded",
    "lineage_records",
    "concise_claims"
  ],
  "properties": {
    "lineage_index_id": {"type": "string", "minLength": 1},
    "planner_contract_id": {"type": "string", "minLength": 1},
    "lineage_store_id": {"type": "string", "minLength": 1},
    "claim_max_characters": {"type": "integer", "minimum": 40},
    "full_lineage_embedded": {"const": false},
    "lineage_records": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "kind", "address", "content_hash", "immutable"],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["signal", "interpretation", "alternative", "constitution_trace"]},
          "address": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "minLength": 1},
          "immutable": {"const": true}
        }
      }
    },
    "concise_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim", "lineage_record_ids"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "lineage_record_ids": {
            "type": "array",
            "minItems": 4,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
