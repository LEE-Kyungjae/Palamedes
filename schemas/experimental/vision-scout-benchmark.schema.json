{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/vision-scout-benchmark.schema.json",
  "title": "Palamedes Blind Vision Scout Benchmark",
  "type": "object",
  "required": [
    "vision_scout_benchmark_version", "vision_scout_benchmark_id", "case_id", "attempt_id",
    "case_origin", "case_fingerprint", "generator_context_fingerprint",
    "hidden_reference_fingerprint", "hidden_anchors_verified_absent",
    "evaluation_custody", "vision_scout_id", "scout_generation_call_count",
    "judge_call_count", "founder_prompt_fingerprint", "founder_prompt_judgment",
    "founder_prompt_thresholds", "founder_prompt_gate_passed", "passed",
    "failure_reasons", "full_genesis_authorized", "delivery_authority_granted",
    "next_authorized_step", "created_at"
  ],
  "properties": {
    "vision_scout_benchmark_version": {"const": "palamedes-vision-scout-benchmark/1"},
    "vision_scout_benchmark_id": {"type": "string", "pattern": "^vision-scout-benchmark-[a-f0-9]{12}$"},
    "case_id": {"type": "string", "minLength": 1},
    "case_origin": {"enum": ["calibration_builtin", "external_human_holdout"]},
    "case_fingerprint": {"type": "string"},
    "attempt_id": {"type": "string", "pattern": "^vision-scout-attempt-[a-f0-9]{12}$"},
    "generator_context_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hidden_reference_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hidden_anchors_verified_absent": {"const": true},
    "evaluation_custody": {"type": "object"},
    "vision_scout_id": {"type": "string", "pattern": "^vision-scout-[a-f0-9]{12}$"},
    "scout_generation_call_count": {"const": 3},
    "judge_call_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "founder_prompt_fingerprint": {"type": "string"},
    "founder_prompt_judgment": {"type": "object"},
    "founder_prompt_thresholds": {"type": "object"},
    "founder_prompt_gate_passed": {"type": "boolean"},
    "passed": {"type": "boolean"},
    "failure_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "full_genesis_authorized": {"const": false},
    "delivery_authority_granted": {"const": false},
    "next_authorized_step": {"enum": ["blind_human_review", "discard"]},
    "human_review_packet_id": {"type": "string", "pattern": "^vision-review-[a-f0-9]{12}$"},
    "provider_usage": {"type": "object"},
    "created_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
