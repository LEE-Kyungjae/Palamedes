{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/emotional-intensity-outcome.schema.json",
  "title": "PalamedesEmotionalIntensityOutcome",
  "description": "Experimental Cycle 116 contract separating durable benefit from manufactured emotional engagement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "experience",
    "short_term_emotional_effect",
    "long_term_relief_or_capability",
    "autonomy_after_exposure",
    "compulsion_check",
    "measurement_window",
    "emotional_intensity_equals_value",
    "engagement_equals_benefit",
    "source_ids",
    "intensity_mechanisms"
  ],
  "properties": {
    "assessment_id": {"type": "string", "minLength": 1},
    "experience": {"type": "string", "minLength": 1},
    "short_term_emotional_effect": {"type": "string", "minLength": 1},
    "long_term_relief_or_capability": {"type": "string", "minLength": 1},
    "autonomy_after_exposure": {"type": "string", "minLength": 1},
    "compulsion_check": {"type": "string", "minLength": 1},
    "measurement_window": {"type": "string", "minLength": 1},
    "emotional_intensity_equals_value": {"const": false},
    "engagement_equals_benefit": {"const": false},
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "intensity_mechanisms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mechanism_id", "mechanism", "detection"],
        "properties": {
          "mechanism_id": {"type": "string", "minLength": 1},
          "mechanism": {"type": "string", "minLength": 1},
          "detection": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
