{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/constitution-layer-registry.schema.json",
  "title": "PalamedesConstitutionLayerRegistry",
  "description": "Experimental Cycle 212 registry for six distinct constitutional layers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layer_registry_id",
    "constitution_version_id",
    "layers_have_equal_authority",
    "layers",
    "interpretation_protocol"
  ],
  "properties": {
    "layer_registry_id": {"type": "string", "minLength": 1},
    "constitution_version_id": {"type": "string", "minLength": 1},
    "layers_have_equal_authority": {"const": false},
    "layers": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "layer_id",
          "layer_type",
          "content_ids",
          "interpretive_role",
          "mutation_authority",
          "review_trigger",
          "overrideable"
        ],
        "properties": {
          "layer_id": {"type": "string", "minLength": 1},
          "layer_type": {
            "enum": [
              "hard_prohibition",
              "defeasible_principle",
              "learned_preference",
              "precedent",
              "uncertainty",
              "authority_grant"
            ]
          },
          "content_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "interpretive_role": {"type": "string", "minLength": 1},
          "mutation_authority": {"type": "string", "minLength": 1},
          "review_trigger": {"type": "string", "minLength": 1},
          "overrideable": {"type": "boolean"},
          "can_authorize_action": {"type": "boolean"},
          "authority_scope": {"type": "string"}
        }
      }
    },
    "interpretation_protocol": {"type": "string", "minLength": 1}
  }
}
