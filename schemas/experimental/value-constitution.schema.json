{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/value-constitution.schema.json",
  "title": "PalamedesValueConstitution",
  "description": "Experimental Cycle 110 revisable, plural, provenance-bearing constitution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "constitution_id",
    "version",
    "parent_version",
    "revision_triggers",
    "clauses"
  ],
  "properties": {
    "constitution_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "parent_version": {"type": ["integer", "null"], "minimum": 1},
    "revision_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clause_id", "kind", "text", "source_ids"],
        "properties": {
          "clause_id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": ["principle", "prohibition", "priority_rule", "standing_obligation"]
          },
          "text": {"type": "string", "minLength": 1},
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
