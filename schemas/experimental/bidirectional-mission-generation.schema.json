{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/bidirectional-mission-generation.schema.json",
  "title": "PalamedesBidirectionalMissionGeneration",
  "description": "Experimental Cycle 231 contract balancing condition-first and capability-first mission generation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_generation_id",
    "generation_context",
    "problem_only_generation",
    "capability_only_generation",
    "mission_candidates",
    "common_comparison_criteria",
    "comparison_protocol",
    "next_selection_gate"
  ],
  "properties": {
    "mission_generation_id": {"type": "string", "minLength": 1},
    "generation_context": {"type": "string", "minLength": 1},
    "problem_only_generation": {"const": false},
    "capability_only_generation": {"const": false},
    "mission_candidates": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "generation_origin",
          "origin_evidence_id",
          "beneficiary",
          "mission_hypothesis",
          "desired_state_change",
          "failure_signal"
        ],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "generation_origin": {"enum": ["condition_first", "capability_first"]},
          "origin_evidence_id": {"type": "string", "minLength": 1},
          "beneficiary": {"type": "string", "minLength": 1},
          "mission_hypothesis": {"type": "string", "minLength": 1},
          "desired_state_change": {"type": "string", "minLength": 1},
          "failure_signal": {"type": "string", "minLength": 1}
        }
      }
    },
    "common_comparison_criteria": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": ["beneficiary_consequence", "constitutional_fit", "evidence_strength", "option_value"]
      }
    },
    "comparison_protocol": {"type": "string", "minLength": 1},
    "next_selection_gate": {"type": "string", "minLength": 1}
  }
}
