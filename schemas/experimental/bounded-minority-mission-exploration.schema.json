{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/bounded-minority-mission-exploration.schema.json",
  "title": "PalamedesBoundedMinorityMissionExploration",
  "description": "Experimental Cycle 248 contract protecting a high-upside minority mission when dominant commitment would destroy its option.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allocation_id",
    "tournament_id",
    "dominant_mission_id",
    "minority_mission_id",
    "expected_upside",
    "high_upside_threshold",
    "upside_evidence_id",
    "dominant_commitment_destroys_option",
    "option_destruction_mechanism",
    "option_destruction_evidence_id",
    "protected_budget",
    "portfolio_exploration_budget",
    "starts_at",
    "expires_at",
    "permanent_protection",
    "exploration_question",
    "stop_trigger",
    "graduation_trigger",
    "review_authority_id",
    "decision",
    "decision_rationale"
  ],
  "properties": {
    "allocation_id": {"type": "string", "minLength": 1},
    "tournament_id": {"type": "string", "minLength": 1},
    "dominant_mission_id": {"type": "string", "minLength": 1},
    "minority_mission_id": {"type": "string", "minLength": 1},
    "expected_upside": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "high_upside_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "upside_evidence_id": {"type": "string", "minLength": 1},
    "dominant_commitment_destroys_option": {"type": "boolean"},
    "option_destruction_mechanism": {"type": "string", "minLength": 1},
    "option_destruction_evidence_id": {"type": "string", "minLength": 1},
    "protected_budget": {"type": "number", "exclusiveMinimum": 0},
    "portfolio_exploration_budget": {"type": "number", "exclusiveMinimum": 0},
    "starts_at": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "minLength": 1},
    "permanent_protection": {"const": false},
    "exploration_question": {"type": "string", "minLength": 1},
    "stop_trigger": {"type": "string", "minLength": 1},
    "graduation_trigger": {"type": "string", "minLength": 1},
    "review_authority_id": {"type": "string"},
    "decision": {"enum": ["protect_bounded_exploration", "reject_protection"]},
    "decision_rationale": {"type": "string", "minLength": 1}
  }
}
