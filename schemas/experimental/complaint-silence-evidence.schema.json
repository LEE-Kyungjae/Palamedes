{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/complaint-silence-evidence.schema.json",
  "title": "PalamedesComplaintSilenceEvidence",
  "description": "Experimental Cycle 113 contract preventing complaint absence from becoming cost absence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_id",
    "complaint_summary",
    "collection_window",
    "source_ids",
    "silence_means_no_cost",
    "articulation_bias",
    "recency_bias",
    "visibility_bias",
    "silent_or_missing_groups"
  ],
  "properties": {
    "analysis_id": {"type": "string", "minLength": 1},
    "complaint_summary": {"type": "string", "minLength": 1},
    "collection_window": {"type": "string", "minLength": 1},
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "silence_means_no_cost": {"const": false},
    "articulation_bias": {"type": "string", "minLength": 1},
    "recency_bias": {"type": "string", "minLength": 1},
    "visibility_bias": {"type": "string", "minLength": 1},
    "silent_or_missing_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "why_missing", "independent_cost_check"],
        "properties": {
          "group_id": {"type": "string", "minLength": 1},
          "why_missing": {"type": "string", "minLength": 1},
          "independent_cost_check": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
