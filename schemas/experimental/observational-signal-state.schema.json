{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/observational-signal-state.schema.json",
  "title": "PalamedesObservationalSignalState",
  "description": "Experimental Cycle 304 signal payload restricted to observation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["signal_id", "epistemic_kind", "source_identity", "observation_method", "observation", "baseline", "deviation", "affected_entity_ids", "uncertainty", "uncertainty_note", "source_incentives", "sensitivity", "received_at", "interprets_meaning", "contains_recommendation", "assigns_mission", "authorizes_action", "changes_constitution", "signal_rationale"],
  "properties": {
    "signal_id": {"type": "string", "minLength": 1},
    "epistemic_kind": {"const": "observation"},
    "source_identity": {"type": "string", "minLength": 1},
    "observation_method": {"type": "string", "minLength": 1},
    "observation": {"type": "string", "minLength": 1},
    "baseline": {"type": "string", "minLength": 1},
    "deviation": {"type": "string", "minLength": 1},
    "affected_entity_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
    "uncertainty_note": {"type": "string", "minLength": 1},
    "source_incentives": {"type": "string", "minLength": 1},
    "sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
    "received_at": {"type": "string", "minLength": 1},
    "interprets_meaning": {"const": false},
    "contains_recommendation": {"const": false},
    "assigns_mission": {"const": false},
    "authorizes_action": {"const": false},
    "changes_constitution": {"const": false},
    "signal_rationale": {"type": "string", "minLength": 1}
  }
}
