{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/versioned-selected-mission-unit.schema.json",
  "title": "PalamedesVersionedSelectedMissionUnit",
  "description": "Experimental Cycle 291 preplanning unit selected from observed conditions under explicit values and authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_artifact_id", "mission_id", "version", "previous_mission_artifact_id", "mission_contract_id", "observed_condition_ids", "explicit_value_ids", "authority_grant_ids", "selected_from_candidate_ids", "selection_record_id", "selection_decision", "selected_at", "state_fingerprint", "idea_only", "planning_started_before_selection", "values_or_authority_implicit", "selection_rationale"],
  "properties": {
    "mission_artifact_id": {"type": "string", "minLength": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "previous_mission_artifact_id": {"type": ["string", "null"]},
    "mission_contract_id": {"type": "string", "minLength": 1},
    "observed_condition_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "explicit_value_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authority_grant_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "selected_from_candidate_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "selection_record_id": {"type": "string", "minLength": 1},
    "selection_decision": {"const": "selected"},
    "selected_at": {"type": "string", "minLength": 1},
    "state_fingerprint": {"type": "string", "minLength": 1},
    "idea_only": {"const": false},
    "planning_started_before_selection": {"const": false},
    "values_or_authority_implicit": {"const": false},
    "selection_rationale": {"type": "string", "minLength": 1}
  }
}
