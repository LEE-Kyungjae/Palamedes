{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/interpretation-thesis-integration.schema.json",
  "title": "PalamedesInterpretationThesisIntegration",
  "description": "Experimental Cycle 230 integration of competing, falsifiable, mission-changing causal interpretation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interpretation_thesis_id",
    "world_model_set_id",
    "causal_sketch_set_id",
    "complexity_review_id",
    "correlation_authority_review_id",
    "historical_analogy_id",
    "surprise_registry_id",
    "normative_separation_id",
    "operational_relevance_id",
    "compression_record_id",
    "mission_option_change_record_id",
    "competing_sketches_present",
    "every_model_falsifiable",
    "causal_complexity_decision_relevant",
    "correlation_authority_bounded",
    "normative_empirical_boundary_explicit",
    "complete_worldview_is_goal",
    "changes_mission_option_set",
    "changes_next_probe",
    "post_decision_compression_present",
    "retained_post_decision_purposes",
    "revision_trigger",
    "conclusion"
  ],
  "properties": {
    "interpretation_thesis_id": {"type": "string", "minLength": 1},
    "world_model_set_id": {"type": "string", "minLength": 1},
    "causal_sketch_set_id": {"type": "string", "minLength": 1},
    "complexity_review_id": {"type": "string", "minLength": 1},
    "correlation_authority_review_id": {"type": "string", "minLength": 1},
    "historical_analogy_id": {"type": "string", "minLength": 1},
    "surprise_registry_id": {"type": "string", "minLength": 1},
    "normative_separation_id": {"type": "string", "minLength": 1},
    "operational_relevance_id": {"type": "string", "minLength": 1},
    "compression_record_id": {"type": "string", "minLength": 1},
    "mission_option_change_record_id": {"type": "string", "minLength": 1},
    "competing_sketches_present": {"const": true},
    "every_model_falsifiable": {"const": true},
    "causal_complexity_decision_relevant": {"const": true},
    "correlation_authority_bounded": {"const": true},
    "normative_empirical_boundary_explicit": {"const": true},
    "complete_worldview_is_goal": {"const": false},
    "changes_mission_option_set": {"type": "boolean"},
    "changes_next_probe": {"type": "boolean"},
    "post_decision_compression_present": {"const": true},
    "retained_post_decision_purposes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["monitoring", "disconfirmation", "reconstruction"]}
    },
    "revision_trigger": {"type": "string", "minLength": 1},
    "conclusion": {"const": "interpretation_thesis_supported"}
  }
}
