{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/mission-contract-thesis-integration.schema.json",
  "title": "PalamedesMissionContractThesisIntegration",
  "description": "Experimental Cycle 260 integration of a compressed causal and normative mission interface that preserves meaning and maximizes planner freedom.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_thesis_id",
    "planner_contract_id",
    "compression_id",
    "situation_meaning_contract_id",
    "beneficiary_condition_contract_id",
    "causal_contract_id",
    "non_goal_contract_id",
    "signal_contract_id",
    "disconfirmation_protocol_id",
    "authority_clause_id",
    "lineage_index_id",
    "causal_interface_components",
    "normative_interface_components",
    "decision_relevant_uncertainty_preserved",
    "situation_and_meaning_preserved",
    "beneficiary_external_change_preserved",
    "essential_causal_mechanisms_preserved",
    "normative_boundaries_preserved",
    "failure_attribution_preserved",
    "authority_return_preserved",
    "full_lineage_addressable",
    "planner_owns_implementation_form",
    "full_reasoning_history_embedded",
    "implementation_form_prescribed",
    "planner_may_rewrite_mission_meaning",
    "handoff_decision",
    "integration_rationale"
  ],
  "properties": {
    "contract_thesis_id": {"type": "string", "minLength": 1},
    "planner_contract_id": {"type": "string", "minLength": 1},
    "compression_id": {"type": "string", "minLength": 1},
    "situation_meaning_contract_id": {"type": "string", "minLength": 1},
    "beneficiary_condition_contract_id": {"type": "string", "minLength": 1},
    "causal_contract_id": {"type": "string", "minLength": 1},
    "non_goal_contract_id": {"type": "string", "minLength": 1},
    "signal_contract_id": {"type": "string", "minLength": 1},
    "disconfirmation_protocol_id": {"type": "string", "minLength": 1},
    "authority_clause_id": {"type": "string", "minLength": 1},
    "lineage_index_id": {"type": "string", "minLength": 1},
    "causal_interface_components": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "normative_interface_components": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "decision_relevant_uncertainty_preserved": {"const": true},
    "situation_and_meaning_preserved": {"const": true},
    "beneficiary_external_change_preserved": {"const": true},
    "essential_causal_mechanisms_preserved": {"const": true},
    "normative_boundaries_preserved": {"const": true},
    "failure_attribution_preserved": {"const": true},
    "authority_return_preserved": {"const": true},
    "full_lineage_addressable": {"const": true},
    "planner_owns_implementation_form": {"const": true},
    "full_reasoning_history_embedded": {"const": false},
    "implementation_form_prescribed": {"const": false},
    "planner_may_rewrite_mission_meaning": {"const": false},
    "handoff_decision": {"const": "eligible"},
    "integration_rationale": {"type": "string", "minLength": 1}
  }
}
