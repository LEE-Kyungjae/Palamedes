{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/non-disruptive-exploration-allocation.schema.json",
  "title": "PalamedesNonDisruptiveExplorationAllocation",
  "description": "Cycle 348 bounded exploration with explicit evidence target and protected dominant commitment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["exploration_allocation_id", "exploration_candidate_id", "exploration_candidate_fingerprint", "cost_budget", "starts_at", "expires_at", "expiration_action", "evidence_target", "protected_commitment", "exploration_reversible", "exploration_stop_condition", "automatic_renewal_allowed", "allocation_rationale"],
  "properties": {
    "exploration_allocation_id": {"type": "string", "minLength": 1},
    "exploration_candidate_id": {"type": "string", "minLength": 1},
    "exploration_candidate_fingerprint": {"type": "string", "minLength": 1},
    "cost_budget": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_cost", "allocated_cost", "unit", "cost_owner_id", "budget_ledger_id"],
      "properties": {
        "maximum_cost": {"type": "number", "exclusiveMinimum": 0},
        "allocated_cost": {"type": "number", "minimum": 0},
        "unit": {"type": "string", "minLength": 1},
        "cost_owner_id": {"type": "string", "minLength": 1},
        "budget_ledger_id": {"type": "string", "minLength": 1}
      }
    },
    "starts_at": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "minLength": 1},
    "expiration_action": {"type": "string", "minLength": 1},
    "evidence_target": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "uncertainty_id", "evidence_question", "qualifying_observation", "disqualifying_observation", "completion_criterion"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "uncertainty_id": {"type": "string", "minLength": 1},
        "evidence_question": {"type": "string", "minLength": 1},
        "qualifying_observation": {"type": "string", "minLength": 1},
        "disqualifying_observation": {"type": "string", "minLength": 1},
        "completion_criterion": {"type": "string", "minLength": 1}
      }
    },
    "protected_commitment": {
      "type": "object", "additionalProperties": false,
      "required": ["mission_contract_id", "mission_contract_fingerprint", "commitment_owner_id", "protected_outcome", "non_disruption_constraints", "exploration_may_preempt_commitment", "shared_resource_unbounded"],
      "properties": {
        "mission_contract_id": {"type": "string", "minLength": 1},
        "mission_contract_fingerprint": {"type": "string", "minLength": 1},
        "commitment_owner_id": {"type": "string", "minLength": 1},
        "protected_outcome": {"type": "string", "minLength": 1},
        "non_disruption_constraints": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["constraint_id", "protected_resource_or_metric", "maximum_interference", "measurement_method", "stop_trigger", "monitoring_active"],
            "properties": {
              "constraint_id": {"type": "string", "minLength": 1},
              "protected_resource_or_metric": {"type": "string", "minLength": 1},
              "maximum_interference": {"type": "string", "minLength": 1},
              "measurement_method": {"type": "string", "minLength": 1},
              "stop_trigger": {"type": "string", "minLength": 1},
              "monitoring_active": {"const": true}
            }
          }
        },
        "exploration_may_preempt_commitment": {"const": false},
        "shared_resource_unbounded": {"const": false}
      }
    },
    "exploration_reversible": {"const": true},
    "exploration_stop_condition": {"type": "string", "minLength": 1},
    "automatic_renewal_allowed": {"const": false},
    "allocation_rationale": {"type": "string", "minLength": 1}
  }
}
