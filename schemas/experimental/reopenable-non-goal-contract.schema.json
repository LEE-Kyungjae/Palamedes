{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/reopenable-non-goal-contract.schema.json",
  "title": "PalamedesReopenableNonGoalContract",
  "description": "Experimental Cycle 255 contract requiring every non-goal to have a reason and an evidence-triggered reopening condition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "non_goal_contract_id",
    "planner_contract_id",
    "blanket_exclusion_allowed",
    "non_goals",
    "review_protocol"
  ],
  "properties": {
    "non_goal_contract_id": {"type": "string", "minLength": 1},
    "planner_contract_id": {"type": "string", "minLength": 1},
    "blanket_exclusion_allowed": {"const": false},
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "non_goal_id",
          "excluded_scope",
          "current_exclusion_reason",
          "attention_resource_protected",
          "reason_evidence_id",
          "reopening_signal",
          "reopening_threshold",
          "review_authority_id",
          "reopening_action",
          "permanent_exclusion",
          "status",
          "reopening_evidence_id",
          "reopened_at"
        ],
        "properties": {
          "non_goal_id": {"type": "string", "minLength": 1},
          "excluded_scope": {"type": "string", "minLength": 1},
          "current_exclusion_reason": {"type": "string", "minLength": 1},
          "attention_resource_protected": {"type": "string", "minLength": 1},
          "reason_evidence_id": {"type": "string", "minLength": 1},
          "reopening_signal": {"type": "string", "minLength": 1},
          "reopening_threshold": {"type": "string", "minLength": 1},
          "review_authority_id": {"type": "string", "minLength": 1},
          "reopening_action": {"type": "string", "minLength": 1},
          "permanent_exclusion": {"const": false},
          "status": {"enum": ["excluded", "reopened"]},
          "reopening_evidence_id": {"type": "string"},
          "reopened_at": {"type": "string"}
        }
      }
    },
    "review_protocol": {"type": "string", "minLength": 1}
  }
}
