{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/single-evolving-signal-comparison-case.schema.json",
  "title": "PalamedesSingleEvolvingSignalComparisonCase",
  "description": "Experimental Cycle 281 minimal comparison system limited to one evolving signal case.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "comparison_system_id",
    "hypothesis_under_test",
    "success_criterion",
    "falsification_criterion",
    "signal_cases",
    "implemented_components",
    "deferred_runtime_components",
    "full_runtime_implemented",
    "production_runtime_claimed",
    "scope_rationale"
  ],
  "properties": {
    "comparison_system_id": {"type": "string", "minLength": 1},
    "hypothesis_under_test": {"type": "string", "minLength": 1},
    "success_criterion": {"type": "string", "minLength": 1},
    "falsification_criterion": {"type": "string", "minLength": 1},
    "signal_cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "initial_situation", "beneficiary_context", "source_bundle_id", "events"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "initial_situation": {"type": "string", "minLength": 1},
          "beneficiary_context": {"type": "string", "minLength": 1},
          "source_bundle_id": {"type": "string", "minLength": 1},
          "events": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["event_id", "observed_at", "observation", "evidence_id", "state_change"],
              "properties": {
                "event_id": {"type": "string", "minLength": 1},
                "observed_at": {"type": "string", "minLength": 1},
                "observation": {"type": "string", "minLength": 1},
                "evidence_id": {"type": "string", "minLength": 1},
                "state_change": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "implemented_components": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["event_sequence", "condition_runner", "output_store"]}
    },
    "deferred_runtime_components": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "full_runtime_implemented": {"const": false},
    "production_runtime_claimed": {"const": false},
    "scope_rationale": {"type": "string", "minLength": 1}
  }
}
