{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/precommitted-assumption-probe-branches.schema.json",
  "title": "PalamedesPrecommittedAssumptionProbeBranches",
  "description": "Cycle 346 safe probe for a selection-controlling assumption with frozen exhaustive result branches.",
  "type": "object",
  "additionalProperties": false,
  "required": ["probe_design_id", "sensitivity_review_id", "controlling_assumption_id", "assumption_fingerprint", "selection_flip_threshold", "selection_controlled_by_single_assumption", "affected_candidate_ids", "probe", "precommitted_branches", "branches_exhaustive", "branches_mutually_exclusive", "branches_frozen_before_observation", "branch_manifest_fingerprint", "posthoc_branch_rewrite_allowed", "selection_before_probe_result", "design_rationale"],
  "properties": {
    "probe_design_id": {"type": "string", "minLength": 1},
    "sensitivity_review_id": {"type": "string", "minLength": 1},
    "controlling_assumption_id": {"type": "string", "minLength": 1},
    "assumption_fingerprint": {"type": "string", "minLength": 1},
    "selection_flip_threshold": {"type": "string", "minLength": 1},
    "selection_controlled_by_single_assumption": {"const": true},
    "affected_candidate_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "probe": {
      "type": "object", "additionalProperties": false,
      "required": ["probe_id", "measurement", "population", "maximum_cost", "maximum_harm", "stop_condition", "expires_at", "observation_method", "safe_within_authority", "reversible"],
      "properties": {
        "probe_id": {"type": "string", "minLength": 1},
        "measurement": {"type": "string", "minLength": 1},
        "population": {"type": "string", "minLength": 1},
        "maximum_cost": {"type": "string", "minLength": 1},
        "maximum_harm": {"type": "string", "minLength": 1},
        "stop_condition": {"type": "string", "minLength": 1},
        "expires_at": {"type": "string", "minLength": 1},
        "observation_method": {"type": "string", "minLength": 1},
        "safe_within_authority": {"const": true},
        "reversible": {"const": true}
      }
    },
    "precommitted_branches": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["branch_id", "interval_index", "result_condition", "lower_bound", "upper_bound", "boundary_semantics", "selected_candidate_ids", "selection_mode", "branch_action", "branch_rationale"],
        "properties": {
          "branch_id": {"type": "string", "minLength": 1},
          "interval_index": {"type": "integer", "minimum": 1},
          "result_condition": {"type": "string", "minLength": 1},
          "lower_bound": {"type": "string", "minLength": 1},
          "upper_bound": {"type": "string", "minLength": 1},
          "boundary_semantics": {"type": "string", "minLength": 1},
          "selected_candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "selection_mode": {"enum": ["commit", "bounded_exploration", "discriminating_probe", "defer"]},
          "branch_action": {"type": "string", "minLength": 1},
          "branch_rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "branches_exhaustive": {"const": true},
    "branches_mutually_exclusive": {"const": true},
    "branches_frozen_before_observation": {"const": true},
    "branch_manifest_fingerprint": {"type": "string", "minLength": 1},
    "posthoc_branch_rewrite_allowed": {"const": false},
    "selection_before_probe_result": {"const": "discriminating_probe"},
    "design_rationale": {"type": "string", "minLength": 1}
  }
}
