{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/independent-mission-generation.schema.json",
  "title": "PalamedesIndependentMissionGeneration",
  "description": "Experimental Cycle 131 contract preventing sequential candidate anchoring.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "opportunity_gate_id",
    "formation_protocol",
    "sequential_cross_contamination_allowed",
    "candidates"
  ],
  "properties": {
    "batch_id": {"type": "string", "minLength": 1},
    "opportunity_gate_id": {"type": "string", "minLength": 1},
    "formation_protocol": {"type": "string", "minLength": 1},
    "sequential_cross_contamination_allowed": {"const": false},
    "candidates": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "mission_thesis",
          "beneficiary_change",
          "mechanism",
          "formed_without_peer_candidates",
          "peer_candidate_ids_visible",
          "evidence_slice_ids"
        ],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "mission_thesis": {"type": "string", "minLength": 1},
          "beneficiary_change": {"type": "string", "minLength": 1},
          "mechanism": {"type": "string", "minLength": 1},
          "formed_without_peer_candidates": {"const": true},
          "peer_candidate_ids_visible": {"type": "array", "maxItems": 0},
          "evidence_slice_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
