{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/contextualized-signal-claim.schema.json",
  "title": "PalamedesContextualizedSignalClaim",
  "description": "Experimental Cycle 208 contract for storing signals as contextualized claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signal_claim_id",
    "source_structure_id",
    "source_id",
    "claim",
    "raw_event_equals_claim",
    "observation_method",
    "affected_entity",
    "observed_at",
    "recorded_at",
    "expected_baseline",
    "observed_deviation",
    "uncertainty",
    "uncertainty_rationale",
    "possible_collection_incentive",
    "evidence_ids",
    "claim_status",
    "inference_basis_ids",
    "next_update_trigger"
  ],
  "properties": {
    "signal_claim_id": {"type": "string", "minLength": 1},
    "source_structure_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "raw_event_equals_claim": {"const": false},
    "observation_method": {"type": "string", "minLength": 1},
    "affected_entity": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "minLength": 1},
    "expected_baseline": {"type": "string", "minLength": 1},
    "observed_deviation": {"type": "string", "minLength": 1},
    "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
    "uncertainty_rationale": {"type": "string", "minLength": 1},
    "possible_collection_incentive": {"type": "string", "minLength": 1},
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claim_status": {"enum": ["observed", "inferred", "contested"]},
    "inference_basis_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "next_update_trigger": {"type": "string", "minLength": 1}
  }
}
