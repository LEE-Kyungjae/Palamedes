{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/strategy-conflict-jurisdiction.schema.json",
  "title": "PalamedesStrategyConflictJurisdiction",
  "description": "Experimental Cycle 177 jurisdiction for purpose versus technical strategy conflicts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jurisdiction_review_id",
    "mission_contract_id",
    "mission_contract_version",
    "planner_proposal_ids",
    "conflict_summary",
    "palamedes_arbitrates_technical_tradeoffs",
    "conflict_dimensions",
    "jurisdiction",
    "jurisdiction_rationale"
  ],
  "properties": {
    "jurisdiction_review_id": {"type": "string", "minLength": 1},
    "mission_contract_id": {"type": "string", "minLength": 1},
    "mission_contract_version": {"type": "string", "minLength": 1},
    "planner_proposal_ids": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 1}
    },
    "conflict_summary": {"type": "string", "minLength": 1},
    "palamedes_arbitrates_technical_tradeoffs": {"const": false},
    "conflict_dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conflict_id", "kind", "dimension", "difference", "evidence_id", "boundary_test"],
        "properties": {
          "conflict_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["purpose", "technical"]},
          "dimension": {"type": "string", "minLength": 1},
          "difference": {"type": "string", "minLength": 1},
          "evidence_id": {"type": "string", "minLength": 1},
          "boundary_test": {"type": "string", "minLength": 1}
        }
      }
    },
    "jurisdiction": {"enum": ["palamedes_purpose_review", "downstream_strategy_resolution"]},
    "jurisdiction_rationale": {"type": "string", "minLength": 1}
  }
}
