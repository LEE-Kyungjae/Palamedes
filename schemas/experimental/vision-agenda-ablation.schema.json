{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/vision-agenda-ablation.schema.json",
  "title": "Palamedes Vision Agenda Ablation",
  "type": "object",
  "required": [
    "vision_agenda_ablation_version",
    "vision_agenda_ablation_id",
    "case_id",
    "case_origin",
    "generator_context_fingerprint",
    "condition_order",
    "challenger_condition",
    "comparator_condition",
    "condition_call_counts",
    "equal_generation_call_count",
    "condition_vision_ids",
    "condition_selected_titles",
    "generator_identity",
    "judge_identity",
    "judge_independent_provider_claimed",
    "judgment",
    "preferred_condition",
    "claim_scope",
    "human_level_creativity_claim_allowed",
    "created_at"
  ],
  "properties": {
    "vision_agenda_ablation_version": {"const": "palamedes-vision-agenda-ablation/1"},
    "vision_agenda_ablation_id": {"type": "string", "pattern": "^vision-agenda-ablation-[a-f0-9]{12}$"},
    "case_id": {"type": "string", "minLength": 1},
    "case_origin": {"enum": ["calibration_builtin", "external_human_holdout"]},
    "generator_context_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "condition_order": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"enum": ["adaptive", "frontier", "conventional"]}, "uniqueItems": true},
    "challenger_condition": {"enum": ["adaptive", "frontier", "conventional"]},
    "comparator_condition": {"enum": ["adaptive", "frontier", "conventional"]},
    "condition_call_counts": {"type": "object", "minProperties": 2, "maxProperties": 2, "properties": {"adaptive": {"const": 7}, "frontier": {"const": 7}, "conventional": {"const": 7}}, "additionalProperties": false},
    "equal_generation_call_count": {"const": true},
    "condition_vision_ids": {"type": "object", "minProperties": 2, "maxProperties": 2, "additionalProperties": {"type": "string", "minLength": 1}},
    "condition_selected_titles": {"type": "object", "minProperties": 2, "maxProperties": 2, "additionalProperties": {"type": "string"}},
    "generator_identity": {"type": "string", "minLength": 1},
    "judge_identity": {"type": "string", "minLength": 1},
    "judge_independent_provider_claimed": {"type": "boolean"},
    "judgment": {"type": "object"},
    "preferred_condition": {"enum": ["adaptive", "frontier", "conventional", "peer", "neither"]},
    "claim_scope": {"enum": ["none", "same_model_equal_call_machine_preference"]},
    "human_level_creativity_claim_allowed": {"const": false},
    "provider_usage": {
      "type": "object",
      "required": ["provider", "model", "attempted_calls", "metered_calls", "unmetered_calls", "totals", "roles"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "attempted_calls": {"const": 15},
        "metered_calls": {"type": "integer", "minimum": 0, "maximum": 15},
        "unmetered_calls": {"type": "integer", "minimum": 0, "maximum": 15},
        "totals": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "roles": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
