{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/vision-benchmark-suite.schema.json",
  "title": "Palamedes Repeated Blinded Vision Benchmark Suite",
  "type": "object",
  "required": ["vision_benchmark_suite_version", "suite_id", "case_ids", "runs_per_case", "record_ids", "run_count", "pass_count", "selected_titles", "created_at"],
  "properties": {
    "vision_benchmark_suite_version": {"const": "palamedes-vision-benchmark-suite/1"},
    "suite_id": {"type": "string", "minLength": 1},
    "case_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "runs_per_case": {"type": "integer", "minimum": 1, "maximum": 5},
    "record_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^vision-benchmark-[a-f0-9]{12}$"}, "uniqueItems": true},
    "run_count": {"type": "integer", "minimum": 1},
    "pass_count": {"type": "integer", "minimum": 0},
    "selected_titles": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
