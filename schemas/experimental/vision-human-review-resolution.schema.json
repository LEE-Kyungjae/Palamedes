{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/vision-human-review-resolution.schema.json",
  "title": "Palamedes Revealed Human Vision Review Resolution",
  "type": "object",
  "required": ["vision_human_review_resolution_version", "vision_human_response_id", "vision_review_packet_id", "packet_fingerprint", "evaluation_artifact", "reviewer_id", "reviewer_kind", "reviewer_relationship", "resolution", "generated_scores", "human_reference_scores", "score_deltas", "confidence", "resolved_at"],
  "properties": {
    "vision_human_review_resolution_version": {"const": "palamedes-vision-human-review-resolution/1"},
    "vision_human_response_id": {"type": "string", "pattern": "^vision-human-review-[a-f0-9]{12}$"},
    "vision_review_packet_id": {"type": "string", "pattern": "^vision-review-[a-f0-9]{12}$"},
    "packet_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "case_id": {"type": "string"},
    "case_origin": {"enum": ["calibration_builtin", "external_human_holdout"]},
    "case_fingerprint": {"type": "string"},
    "trial_id": {"type": "string"},
    "evaluation_artifact": {"const": "founder_prompt"},
    "source_artifact_type": {"enum": ["vision_genesis", "vision_scout"]},
    "source_artifact_id": {"type": "string"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewer_kind": {"enum": ["human", "model"]},
    "reviewer_relationship": {"enum": ["independent", "team", "author", "unknown"]},
    "reviewer_is_case_author": {"type": "boolean"},
    "resolution": {"enum": ["generated_preferred", "reference_preferred", "peer", "neither"]},
    "generated_scores": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 100}},
    "human_reference_scores": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 100}},
    "score_deltas": {"type": "object", "additionalProperties": {"type": "integer", "minimum": -100, "maximum": 100}},
    "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
    "resolved_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
