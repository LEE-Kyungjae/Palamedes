{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palamedes.local/schemas/experimental/informed-possibility-exposure.schema.json",
  "title": "PalamedesInformedPossibilityExposure",
  "description": "Experimental Cycle 118 contract exposing authorship and eliciting informed preference cheaply.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exposure_id",
    "possibility_id",
    "affected_group_id",
    "excluded_perspectives",
    "exposure_artifact",
    "informed_preference_question",
    "rollback",
    "reversible",
    "creates_commitment",
    "risk_level",
    "cost_level",
    "imagined_by",
    "encoded_assumptions",
    "situated_response_signals"
  ],
  "properties": {
    "exposure_id": {"type": "string", "minLength": 1},
    "possibility_id": {"type": "string", "minLength": 1},
    "affected_group_id": {"type": "string", "minLength": 1},
    "excluded_perspectives": {"type": "string", "minLength": 1},
    "exposure_artifact": {"type": "string", "minLength": 1},
    "informed_preference_question": {"type": "string", "minLength": 1},
    "rollback": {"type": "string", "minLength": 1},
    "reversible": {"const": true},
    "creates_commitment": {"const": false},
    "risk_level": {"enum": ["minimal", "low"]},
    "cost_level": {"enum": ["negligible", "low"]},
    "imagined_by": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor_id", "standpoint", "interest"],
        "properties": {
          "actor_id": {"type": "string", "minLength": 1},
          "standpoint": {"type": "string", "minLength": 1},
          "interest": {"type": "string", "minLength": 1}
        }
      }
    },
    "encoded_assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "situated_response_signals": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
