FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY packages/rag_server/requirements.txt ./requirements.txt

# The frozen upstream Dockerfile requests torch==2.5.1+cpu, but the current
# PyTorch CPU index publishes the 2.5.1 wheel without that local-version
# suffix. Keep the same Torch release while recording the packaging-only
# compatibility adjustment in the prospective case.
RUN pip install --upgrade pip \
    && pip install --index-url https://download.pytorch.org/whl/cpu torch==2.5.1 \
    && pip install -r requirements.txt

COPY packages/rag_server/app ./app

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
